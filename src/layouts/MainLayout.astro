---
interface Props {
  title: string;
  description?: string;
  schema?: object;
  ogImage?: string;
}

const { title, description, schema, ogImage } = Astro.props;
const ogImageUrl = ogImage
  ? `https://bluecapit.com${ogImage}`
  : 'https://bluecapit.com/images/BLUECAPTwitter.jpg';

import '../styles/style.css';
import { Icon } from 'astro-icon/components';
