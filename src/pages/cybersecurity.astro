---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Coro, and why does Blue Cap IT recommend it for cybersecurity?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Coro is an all-in-one cybersecurity platform built specifically for small and mid-sized businesses — protecting endpoints, email, cloud apps, networks, and data from one agent and one dashboard. Most cybersecurity tools were designed for large enterprises with dedicated security teams; Coro was designed for businesses that don't have one. As a Coro Partner, Blue Cap IT handles deployment, configuration, ongoing policy tuning, and threat response — so you get enterprise-grade protection without having to staff a security operations center."
      }
    },
    {
      "@type": "Question",
      "name": "Can I pick and choose Coro modules, or is it all-or-nothing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Coro is fully modular. You can start with one module (most clients start with endpoint protection or email security), then add cloud app security, network security with Zero Trust, data governance, or security awareness training as your needs grow. You're not paying for protection you don't need today, and there's no rip-and-replace when you expand — just turn on the next module from the same dashboard."
      }
    },
    {
      "@type": "Question",
      "name": "Does Coro replace my existing antivirus and email security tools?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In most cases, yes. Coro's endpoint protection is next-generation antivirus plus EDR (Endpoint Detection and Response) in one — replacing legacy AV products like Symantec, McAfee, or Webroot. Coro Email Security replaces add-on products like Mimecast or Proofpoint for Microsoft 365 / Google Workspace. We'll audit what you have today and only recommend swaps that close a gap or save you money — no churn for the sake of it."
      }
    },
    {
      "@type": "Question",
      "name": "What's the difference between Coro and Huntress, and do I need both?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Coro is a unified cybersecurity platform — software you deploy that automates threat detection and response across endpoints, email, cloud, and network. Huntress adds a 24/7 human Security Operations Center (SOC) on top — real analysts who triage alerts, hunt for threats, and respond to incidents around the clock. Coro handles the volume; Huntress handles the hard calls. Many of our clients run both: Coro as the platform, Huntress as the SOC. Call (410) 858-4031 and we'll walk you through which combination fits your risk profile."
      }
    },
    {
      "@type": "Question",
      "name": "How long does Coro take to deploy, and do I need a security team to manage it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most deployments are live in under a day — one lightweight agent rolls out to endpoints, email and cloud connections are configured through API integrations, and policies are tuned to your environment. You do not need an internal security team. Blue Cap IT manages the platform for you: ongoing policy updates, alert review, incident response, and quarterly security posture reviews. You see what's happening through the dashboard, but the day-to-day operation is on us."
      }
    }
  ]
};
---
<MainLayout title="Cybersecurity | Blue Cap IT — Mid-Atlantic &amp; Carolinas" description="Coro all-in-one cybersecurity for SMBs across MD, DC, DE, NJ, PA, VA, NC, SC — endpoint, email, cloud app, network, data, training. One platform, one agent." schema={faqSchema}>
  <div class="inner-hero">
    <div class="section-inner">
      <img src="/images/cybersecurity-hero.jpg" alt="Close-up of an illuminated laptop keyboard glowing blue — symbolizing digital security" style="width:100%;height:auto;max-height:340px;object-fit:cover;border-radius:1rem;margin-bottom:2rem;box-shadow:0 8px 32px rgba(0,0,0,0.2);" />
      <div class="crumbs"><a href="index.html">Home</a> <span>/</span> Cybersecurity</div>
      <div class="section-label">Coro Partner</div>
      <h1>Cybersecurity <span class="grad">Made Simple</span></h1>
      <p class="section-sub">Blue Cap IT partners with Coro to bring enterprise-grade cybersecurity to small and mid-sized businesses — without the complexity. One platform. One agent. Complete protection.</p>
    </div>
  </div>

  <!-- WHY CORO -->
  <section>
    <div class="section-inner">
      <div class="why-grid">
        <div>
          <div class="section-label">Why Coro</div>
          <h2>All-in-One Cybersecurity.<br/><span class="grad">Built for Your Business.</span></h2>
          <p class="section-sub">Most cybersecurity solutions were built for large enterprises with dedicated security teams. Coro was purpose-built for businesses like yours — powerful protection that doesn't require a team of specialists to manage.</p>
          <p class="section-sub" style="margin-top:1rem;">As a Coro Partner, Blue Cap IT deploys, configures, and manages Coro's platform for you — so you get complete cybersecurity coverage with zero added complexity.</p>
          <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap;">
            <a href="contact.html" class="btn-primary">Get a Free Quote</a>
            <a href="tel:4108584031" class="btn-ghost">Call (410) 858-4031</a>
          </div>
        </div>
        <ul class="why-list">
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:shield" /></div>
            <div><h4>Complete Coverage</h4><p>Email, endpoints, cloud apps, network, and data — all protected from a single platform. No gaps, no bolt-on tools.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:bot" /></div>
            <div><h4>AI-Powered Automation</h4><p>Coro's AI engine automatically detects and resolves threats — handling the vast majority of security events without manual intervention.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:zap" /></div>
            <div><h4>Simple to Deploy</h4><p>One lightweight agent, one dashboard, one platform. No complex integrations or multi-vendor headaches.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:trending-up" /></div>
            <div><h4>Scales With You</h4><p>Modular design lets you activate only the protection modules you need today — and add more as your business grows.</p></div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- IMAGE BAND -->
  <section style="padding:0 4% 4rem;">
    <div style="max-width:1100px;margin:0 auto;">
      <img src="/images/cybersecurity-modules.jpg" alt="Security operator working across multiple laptops monitoring threat activity" style="width:100%;height:auto;max-height:380px;object-fit:cover;border-radius:1rem;box-shadow:0 8px 32px rgba(0,0,0,0.2);" />
    </div>
  </section>

  <!-- CORO MODULES -->
  <section style="background:var(--surface);">
    <div class="section-inner">
      <div style="text-align:center;max-width:640px;margin:0 auto 2rem;">
        <div class="section-label">Coro Security Modules</div>
        <h2>One Platform.<br/><span class="grad">Total Protection.</span></h2>
        <p class="section-sub" style="margin:0.8rem auto 0;text-align:center;">Coro combines the security tools you'd normally buy separately into one unified, AI-driven platform.</p>
      </div>
      <div class="products-grid">
        <a href="coro-endpoint.html" class="product-card" style="text-decoration:none;color:inherit;">
          <div class="pcard-icon"><Icon name="lucide:laptop" /></div>
          <h3>Endpoint Protection</h3>
          <p>Next-gen antivirus and EDR (Endpoint Detection &amp; Response) for every device. Detects malware, ransomware, and advanced threats — then automatically contains and remediates them.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
        <a href="coro-email.html" class="product-card" style="text-decoration:none;color:inherit;">
          <div class="pcard-icon"><Icon name="lucide:mail" /></div>
          <h3>Email Security</h3>
          <p>Blocks phishing, business email compromise, malware attachments, and spam before they reach your inbox. Works with Microsoft 365 and Google Workspace.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
        <a href="coro-cloud.html" class="product-card" style="text-decoration:none;color:inherit;">
          <div class="pcard-icon"><Icon name="lucide:cloud" /></div>
          <h3>Cloud App Security</h3>
          <p>Monitors and protects your cloud applications — Microsoft 365, Google Workspace, Slack, Salesforce, and more. Detects unauthorized access, data leaks, and suspicious activity.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
        <a href="coro-network.html" class="product-card" style="text-decoration:none;color:inherit;">
          <div class="pcard-icon"><Icon name="lucide:globe" /></div>
          <h3>Network Security</h3>
          <p>Zero Trust Network Access (ZTNA), VPN, firewall, and DNS filtering. Control who can access your network and what they can reach — from anywhere.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
        <a href="coro-data.html" class="product-card" style="text-decoration:none;color:inherit;">
          <div class="pcard-icon"><Icon name="lucide:folder-lock" /></div>
          <h3>Data Governance</h3>
          <p>Discover, classify, and protect sensitive data across your organization. Enforce policies to prevent data loss and maintain compliance with industry regulations.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
        <a href="coro-training.html" class="product-card" style="text-decoration:none;color:inherit;">
          <div class="pcard-icon"><Icon name="lucide:graduation-cap" /></div>
          <h3>Security Awareness Training</h3>
          <p>Educate your employees with engaging security training and simulated phishing campaigns. Turn your team from a vulnerability into your first line of defense.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section>
    <div class="section-inner">
      <div style="text-align:center;max-width:640px;margin:0 auto 2rem;">
        <div class="section-label">How It Works</div>
        <h2>Getting Started Is <span class="grad">Easy</span></h2>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1.5rem;max-width:900px;margin:0 auto;">
        <div class="spec-card" style="text-align:center;padding:2rem 1.2rem;">
          <div style="font-size:2.5rem;font-weight:800;color:var(--elec);margin-bottom:0.7rem;font-family:'Sora',sans-serif;line-height:1;">1</div>
          <div style="font-family:'Sora',sans-serif;font-weight:700;font-size:0.95rem;color:var(--navy);margin-bottom:0.5rem;">Free Assessment</div>
          <div style="font-size:0.85rem;color:var(--text-muted);">We evaluate your current security posture and identify gaps in your protection.</div>
        </div>
        <div class="spec-card" style="text-align:center;padding:2rem 1.2rem;">
          <div style="font-size:2.5rem;font-weight:800;color:var(--elec);margin-bottom:0.7rem;font-family:'Sora',sans-serif;line-height:1;">2</div>
          <div style="font-family:'Sora',sans-serif;font-weight:700;font-size:0.95rem;color:var(--navy);margin-bottom:0.5rem;">Custom Plan</div>
          <div style="font-size:0.85rem;color:var(--text-muted);">We recommend the right Coro modules for your business needs and budget.</div>
        </div>
        <div class="spec-card" style="text-align:center;padding:2rem 1.2rem;">
          <div style="font-size:2.5rem;font-weight:800;color:var(--elec);margin-bottom:0.7rem;font-family:'Sora',sans-serif;line-height:1;">3</div>
          <div style="font-family:'Sora',sans-serif;font-weight:700;font-size:0.95rem;color:var(--navy);margin-bottom:0.5rem;">Deploy &amp; Protect</div>
          <div style="font-size:0.85rem;color:var(--text-muted);">We deploy the Coro agent, configure your policies, and start protecting your business — typically in under a day.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- PARTNERSHIP -->
  <section style="background:var(--surface);">
    <div class="section-inner" style="text-align:center;max-width:700px;margin:0 auto;">
      <div class="section-label">Our Partnership</div>
      <h2>Official <span class="grad">Coro Partner</span></h2>
      <p class="section-sub" style="text-align:center;margin:0.8rem auto 1.5rem;">Coro is purpose-built cybersecurity for small and mid-sized businesses. Blue Cap IT is proud to be an official Coro Partner — bringing enterprise-grade cyber protection to businesses that need it most.</p>
      <img src="/Coro/coro-logo-wide-indigo.png" alt="Coro" style="height:50px;width:auto;margin:0 auto 2rem;display:block;"/>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1.2rem;max-width:700px;margin:0 auto;">
        <div class="spec-card" style="text-align:center;padding:1.8rem 1rem;"><div style="font-size:2rem;margin-bottom:0.7rem;color:var(--elec);"><Icon name="lucide:shield" /></div><div style="font-family:'Sora',sans-serif;font-weight:700;font-size:0.9rem;color:var(--navy);margin-bottom:0.3rem;">Coro Partner</div><div style="font-size:0.8rem;color:var(--text-muted);">Authorized Coro Reseller</div></div>
        <div class="spec-card" style="text-align:center;padding:1.8rem 1rem;"><div style="font-size:2rem;margin-bottom:0.7rem;color:var(--elec);"><Icon name="lucide:bot" /></div><div style="font-family:'Sora',sans-serif;font-weight:700;font-size:0.9rem;color:var(--navy);margin-bottom:0.3rem;">AI-Driven</div><div style="font-size:0.8rem;color:var(--text-muted);">Automated Threat Resolution</div></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bcit-faq" aria-labelledby="cybersecurity-faq-heading">
    <h2 id="cybersecurity-faq-heading" class="bcit-faq__heading">Frequently Asked Questions</h2>
    <p class="bcit-faq__intro">Common questions about Coro cybersecurity from Blue Cap IT — endpoint protection, email security, cloud app security, network security, data governance, and security awareness training — for businesses across Maryland, DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina.</p>

    <details class="bcit-faq__item">
      <summary>What is Coro, and why does Blue Cap IT recommend it for cybersecurity?</summary>
      <div class="bcit-faq__answer">
        <p>Coro is an all-in-one cybersecurity platform built specifically for small and mid-sized businesses — protecting endpoints, email, cloud apps, networks, and data from one agent and one dashboard. Most cybersecurity tools were designed for large enterprises with dedicated security teams; Coro was designed for businesses that don't have one. As a Coro Partner, Blue Cap IT handles deployment, configuration, ongoing policy tuning, and threat response — so you get enterprise-grade protection without having to staff a security operations center.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Can I pick and choose Coro modules, or is it all-or-nothing?</summary>
      <div class="bcit-faq__answer">
        <p>Coro is fully modular. You can start with one module (most clients start with endpoint protection or email security), then add cloud app security, network security with Zero Trust, data governance, or security awareness training as your needs grow. You're not paying for protection you don't need today, and there's no rip-and-replace when you expand — just turn on the next module from the same dashboard.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Does Coro replace my existing antivirus and email security tools?</summary>
      <div class="bcit-faq__answer">
        <p>In most cases, yes. Coro's endpoint protection is next-generation antivirus plus EDR (Endpoint Detection and Response) in one — replacing legacy AV products like Symantec, McAfee, or Webroot. Coro Email Security replaces add-on products like Mimecast or Proofpoint for Microsoft 365 / Google Workspace. We'll audit what you have today and only recommend swaps that close a gap or save you money — no churn for the sake of it.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>What's the difference between Coro and Huntress, and do I need both?</summary>
      <div class="bcit-faq__answer">
        <p>Coro is a unified cybersecurity platform — software you deploy that automates threat detection and response across endpoints, email, cloud, and network. Huntress adds a 24/7 human Security Operations Center (SOC) on top — real analysts who triage alerts, hunt for threats, and respond to incidents around the clock. Coro handles the volume; Huntress handles the hard calls. Many of our clients run both: Coro as the platform, Huntress as the SOC. Call (410) 858-4031 and we'll walk you through which combination fits your risk profile.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>How long does Coro take to deploy, and do I need a security team to manage it?</summary>
      <div class="bcit-faq__answer">
        <p>Most deployments are live in under a day — one lightweight agent rolls out to endpoints, email and cloud connections are configured through API integrations, and policies are tuned to your environment. You do not need an internal security team. Blue Cap IT manages the platform for you: ongoing policy updates, alert review, incident response, and quarterly security posture reviews. You see what's happening through the dashboard, but the day-to-day operation is on us.</p>
      </div>
    </details>

    <div class="bcit-faq__cta">
      <p><strong>Still have questions?</strong> Call <a href="tel:4108584031">(410) 858-4031</a> or <a href="/contact">request a free cybersecurity assessment</a> — we'll review your current security posture, identify gaps, and recommend the Coro modules (and optional Huntress SOC) that fit your business.</p>
    </div>
  </section>

  <!-- CTA -->
  <div class="cta-band">
    <div class="section-label">Let's Talk Cybersecurity</div>
    <h2>Protect Your Business<br/><span class="grad">with Blue Cap IT + Coro</span></h2>
    <p>Contact us for a free cybersecurity assessment. We'll evaluate your current security posture and show you how Coro can close the gaps — with simple, transparent pricing.</p>
    <div class="btn-group">
      <a href="contact.html" class="btn-primary">Get a Free Quote</a>
      <a href="tel:4108584031" class="btn-ghost"><Icon name="lucide:phone" /> (410) 858-4031</a>
      <a href="mailto:info@bluecapit.com" class="btn-ghost"><Icon name="lucide:mail" /> info@bluecapit.com</a>
    </div>
  </div>
</MainLayout>
