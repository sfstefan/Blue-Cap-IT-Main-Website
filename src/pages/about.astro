---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What does \"boutique\" mean in the context of Blue Cap IT?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Boutique means we're intentionally small. We're big enough to staff every layer of modern IT — managed services, networking, cybersecurity, physical security, and video intelligence — but small enough that you reach the engineer who designed your network when you call, not a ticket queue in another time zone. The trade-off is that we won't onboard hundreds of clients a year. That's the point. Our clients get a partner who knows their business by name, not a customer number."
      }
    },
    {
      "@type": "Question",
      "name": "What kinds of businesses does Blue Cap IT typically work with?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Small and mid-sized businesses across the Mid-Atlantic and Carolinas — typically 10 to 500 employees. We serve professional services firms (law, accounting, consulting), healthcare practices, manufacturers, nonprofits, schools, real estate companies, and businesses in the trades. The common thread isn't industry — it's that our clients want enterprise-grade technology delivered by a partner who actually understands their business, without the bureaucracy of a national MSP."
      }
    },
    {
      "@type": "Question",
      "name": "Why work with Blue Cap IT instead of a large MSP or hiring an internal IT manager?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Three reasons. First, breadth: a single internal IT person can't credibly cover everything from helpdesk to firewall design to physical security to cybersecurity strategy — Blue Cap IT brings specialists in every layer. Second, cost: an experienced internal IT manager runs six figures all-in, which is more than most clients spend on our full managed services. Third, service: large national MSPs run ticket queues across multiple time zones and shuffle accounts between reps; we don't. You get the same engineers every time you call, and you get the technical depth of a big provider without the impersonal experience."
      }
    },
    {
      "@type": "Question",
      "name": "What partnerships and certifications does Blue Cap IT hold?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Blue Cap IT is a Verkada Gold Partner (physical security), Coro Partner (cybersecurity platform), Huntress Partner (24/7 managed security), spot.ai Partner (AI video intelligence), and Meter Partner (Network as a Service). These are technical partnerships — earned through certified training, demonstrated installation expertise, and ongoing volume — not quota relationships. We deploy and support the full stack ourselves rather than reselling and forwarding tickets."
      }
    },
    {
      "@type": "Question",
      "name": "Where is Blue Cap IT located, and how do you support clients across multiple states?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Blue Cap IT is based in Maryland. We provide on-site service across Maryland, Washington DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina — handling installations, site assessments, and physical security deployments throughout the Mid-Atlantic and Carolinas region. Day-to-day operations (monitoring, helpdesk, patching, cybersecurity, network management) are delivered remotely from our team, so location rarely affects service quality. For cloud-only services like Microsoft 365 management or Coro cybersecurity, we work with businesses anywhere in the United States."
      }
    }
  ]
};
---
<MainLayout title="About Blue Cap IT — Mid-Atlantic &amp; Carolinas IT Partner" description="Blue Cap IT is a boutique IT partner serving MD, DC, DE, NJ, PA, VA, NC, SC — managed IT, NaaS, cybersecurity, physical security &amp; video intelligence." schema={faqSchema}>
  <div class="inner-hero">
    <div class="section-inner">
      <img src="/images/about-hero.webp" alt="A small group of professionals gathered around a wooden table with notepads — a client meeting in natural light" style="width:100%;height:auto;max-height:340px;object-fit:cover;border-radius:1rem;margin-bottom:2rem;box-shadow:0 8px 32px rgba(0,0,0,0.2);" width="1600" height="1067" fetchpriority="high" />
      <div class="crumbs"><a href="index.html">Home</a> <span>/</span> About</div>
      <div class="section-label">Who We Are</div>
      <h1>About <span class="grad">Blue Cap IT</span></h1>
      <p class="section-sub">Blue Cap IT is your boutique IT partner. We combine enterprise-grade technology with the personal service of a trusted advisor — focused on client outcomes, customer service, and education over upsell.</p>
    </div>
  </div>

  <!-- MISSION -->
  <section>
    <div class="section-inner">
      <div class="why-grid">
        <div>
          <div class="section-label">Our Approach</div>
          <h2>A Boutique <span class="grad">IT Partner.</span></h2>
          <p class="section-sub">Big providers chase scale. We chose to stay small enough to learn your business, your systems, and your goals personally. When you call us, you reach the person who designed your network — not a ticket queue across three time zones.</p>
          <p class="section-sub" style="margin-top:1rem;">We measure success by your outcomes — uptime, productivity, peace of mind — not by how much we sold you last quarter. Most of our clients have been with us for years because we earn the relationship every day. Slow ticket response, missed renewal date, surprise charge? Those don't happen here.</p>
          <p class="section-sub" style="margin-top:1rem;">We'd rather teach you something than sell you something. Our job is to understand where your business is going and recommend technology that fits — even if that means recommending less. Every engagement starts with a free assessment, transparent pricing, and a roadmap you can actually understand.</p>
          <p class="section-sub" style="margin-top:1rem;">Behind that boutique service is enterprise-grade technology. We're a Verkada Gold Partner, Coro Partner, Huntress Partner, spot.ai Partner, and Meter Partner — partnerships built on technical certifications, not vendor quotas. You get the best tools in the industry, deployed and managed by people who know how to use them.</p>
          <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap;">
            <a href="contact.html" class="btn-primary">Get a Free Quote</a>
            <a href="services.html" class="btn-ghost">Explore Services</a>
          </div>
        </div>
        <ul class="why-list">
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:gem" /></div>
            <div><h4>Boutique Partner</h4><p>Small enough to know you personally. Big enough to handle every layer of your IT, security, and networking — under one accountable roof.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:heart-handshake" /></div>
            <div><h4>Customer Service First</h4><p>Real people who know your systems. Quick response times, no ticket queue across time zones, no escalation maze, no surprise charges.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:target" /></div>
            <div><h4>Outcomes Over Activity</h4><p>We measure success by your uptime, productivity, and peace of mind — not by how much we sold you last quarter.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:graduation-cap" /></div>
            <div><h4>Education &amp; Strategic Consulting</h4><p>We'd rather teach you than sell to you. Every engagement starts with a free assessment, transparent pricing, and a roadmap you can understand.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:map-pin" /></div>
            <div><h4>Local &amp; Responsive</h4><p>We're local. Hands-on support, fast response times, and the kind of accountability that remote providers simply can't match.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:handshake" /></div>
            <div><h4>Long-Term Relationships</h4><p>Most of our clients have been with us for years. We earn that every day with transparency, integrity, and follow-through.</p></div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CONSULTING IMAGE BAND -->
  <section style="padding:0 4% 4rem;">
    <div style="max-width:1100px;margin:0 auto;">
      <img src="/images/about-consulting.webp" alt="Two professionals sketching a strategy plan together at a desk — illustrating Blue Cap IT's consulting approach" style="width:100%;height:auto;max-height:380px;object-fit:cover;border-radius:1rem;box-shadow:0 8px 32px rgba(0,0,0,0.2);" width="1600" height="1068" loading="lazy" decoding="async" />
    </div>
  </section>

  <!-- WHAT WE DELIVER — clickable services -->
  <section style="background:var(--off-white);">
    <div class="section-inner">
      <div style="text-align:center;max-width:680px;margin:0 auto 2rem;">
        <div class="section-label">What We Deliver</div>
        <h2>Full-Stack IT Services.<br/><span class="grad">Backed by Industry Leaders.</span></h2>
        <p class="section-sub" style="margin:0.8rem auto 0;text-align:center;">Six service areas, one accountable partner. Each is delivered through a best-in-class technology partnership — and managed end-to-end by Blue Cap IT.</p>
      </div>
      <div class="products-grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));max-width:1100px;margin:0 auto;">
        <a href="managed-services.html" class="product-card" style="text-decoration:none;color:inherit;border-top:3px solid var(--elec);">
          <div class="pcard-icon"><Icon name="lucide:monitor" /></div>
          <h3>Managed IT Services</h3>
          <p>Helpdesk, monitoring, patching, backup, Microsoft 365, network management, and vCIO — your complete outsourced IT department.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
        <a href="naas.html" class="product-card" style="text-decoration:none;color:inherit;border-top:3px solid #4a1d96;">
          <div class="pcard-icon"><Icon name="lucide:globe" /></div>
          <h3>Network as a Service</h3>
          <p>Your entire network as one monthly subscription — switches, Wi-Fi 7, firewalls, 5G gateway, install, and 24/7 management. Zero upfront costs.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
        <a href="cybersecurity.html" class="product-card" style="text-decoration:none;color:inherit;border-top:3px solid #6366f1;">
          <div class="pcard-icon"><Icon name="lucide:shield" /></div>
          <h3>Cybersecurity</h3>
          <p>All-in-one cybersecurity through our Coro partnership — endpoint, email, cloud, network, data governance, and security training.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
        <a href="huntress.html" class="product-card" style="text-decoration:none;color:inherit;border-top:3px solid #00b4a0;">
          <div class="pcard-icon"><Icon name="lucide:target" /></div>
          <h3>Managed Security</h3>
          <p>24/7 SOC-backed protection through Huntress — managed EDR, identity threat detection, SIEM, and security awareness training.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
        <a href="verkada.html" class="product-card" style="text-decoration:none;color:inherit;border-top:3px solid #0a2540;">
          <div class="pcard-icon"><Icon name="lucide:camera" /></div>
          <h3>Physical Security</h3>
          <p>Cloud-managed cameras, access control, sensors, alarms, and intercoms — delivered through our Verkada Gold Partnership.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
        <a href="spotai.html" class="product-card" style="text-decoration:none;color:inherit;border-top:3px solid #1a1a2e;">
          <div class="pcard-icon"><Icon name="lucide:video" /></div>
          <h3>AI Video Intelligence</h3>
          <p>Camera-agnostic AI through spot.ai — turn your existing cameras into active teammates with deep-learning analytics and real-time alerts.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PARTNER SECTION -->
  <section style="background:var(--surface);">
    <div class="section-inner" style="text-align:center;max-width:700px;margin:0 auto;">
      <div class="section-label">Our Partnerships</div>
      <h2>Trusted <span class="grad">Technology Partners</span></h2>
      <p class="section-sub" style="text-align:center;margin:0.8rem auto 1.5rem;">Blue Cap IT partners with industry leaders to bring the best technology to our clients. Our partnerships mean you get enterprise-grade solutions backed by world-class support.</p>
      <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:2rem;margin:0 auto 2rem;">
        <img src="/images/verkada-partner.webp" alt="Verkada Authorized Reseller" style="height:36px;width:auto;" width="1600" height="226" loading="lazy" decoding="async" />
        <img src="/Coro/coro-logo-wide-indigo.webp" alt="Coro Partner" style="height:40px;width:auto;" width="1348" height="447" loading="lazy" decoding="async" />
        <img src="/Huntress/huntress-logo-teal.webp" alt="Huntress Partner" style="height:36px;width:auto;" width="1600" height="394" loading="lazy" decoding="async" />
        <img src="/spotai/spotai-logo.webp" alt="spot.ai Partner" style="height:32px;width:auto;" width="454" height="111" loading="lazy" decoding="async" />
        <img src="/meter/Meter-purple.webp" alt="Meter Partner" style="height:32px;width:auto;" width="1600" height="600" loading="lazy" decoding="async" />
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1.2rem;max-width:900px;margin:0 auto;">
        <div class="spec-card" style="text-align:center;padding:1.8rem 1rem;"><div style="font-size:2rem;margin-bottom:0.7rem;color:var(--elec);"><Icon name="lucide:medal" /></div><div style="font-family:'Sora',sans-serif;font-weight:700;font-size:0.9rem;color:var(--navy);margin-bottom:0.3rem;">Verkada Gold Partner</div><div style="font-size:0.8rem;color:var(--text-muted);">Physical Security Platform</div></div>
        <div class="spec-card" style="text-align:center;padding:1.8rem 1rem;"><div style="font-size:2rem;margin-bottom:0.7rem;color:var(--elec);"><Icon name="lucide:shield" /></div><div style="font-family:'Sora',sans-serif;font-weight:700;font-size:0.9rem;color:var(--navy);margin-bottom:0.3rem;">Coro Partner</div><div style="font-size:0.8rem;color:var(--text-muted);">All-in-One Cybersecurity</div></div>
        <div class="spec-card" style="text-align:center;padding:1.8rem 1rem;"><div style="font-size:2rem;margin-bottom:0.7rem;color:var(--elec);"><Icon name="lucide:target" /></div><div style="font-family:'Sora',sans-serif;font-weight:700;font-size:0.9rem;color:var(--navy);margin-bottom:0.3rem;">Huntress Partner</div><div style="font-size:0.8rem;color:var(--text-muted);">24/7 Managed Security</div></div>
        <div class="spec-card" style="text-align:center;padding:1.8rem 1rem;"><div style="font-size:2rem;margin-bottom:0.7rem;color:var(--elec);"><Icon name="lucide:video" /></div><div style="font-family:'Sora',sans-serif;font-weight:700;font-size:0.9rem;color:var(--navy);margin-bottom:0.3rem;">spot.ai Partner</div><div style="font-size:0.8rem;color:var(--text-muted);">AI Video Intelligence</div></div>
        <div class="spec-card" style="text-align:center;padding:1.8rem 1rem;"><div style="font-size:2rem;margin-bottom:0.7rem;color:var(--elec);"><Icon name="lucide:globe" /></div><div style="font-family:'Sora',sans-serif;font-weight:700;font-size:0.9rem;color:var(--navy);margin-bottom:0.3rem;">Meter Partner</div><div style="font-size:0.8rem;color:var(--text-muted);">Enterprise Networking</div></div>
        <div class="spec-card" style="text-align:center;padding:1.8rem 1rem;"><div style="font-size:2rem;margin-bottom:0.7rem;color:var(--elec);"><Icon name="lucide:monitor" /></div><div style="font-family:'Sora',sans-serif;font-weight:700;font-size:0.9rem;color:var(--navy);margin-bottom:0.3rem;">Managed Services</div><div style="font-size:0.8rem;color:var(--text-muted);">Complete IT Management</div></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bcit-faq" aria-labelledby="about-faq-heading">
    <h2 id="about-faq-heading" class="bcit-faq__heading">Frequently Asked Questions</h2>
    <p class="bcit-faq__intro">Common questions about Blue Cap IT — our approach, services, partnerships, and how we work with small and mid-sized businesses across the Mid-Atlantic and Carolinas.</p>

    <details class="bcit-faq__item">
      <summary>What does "boutique" mean in the context of Blue Cap IT?</summary>
      <div class="bcit-faq__answer">
        <p>Boutique means we're intentionally small. We're big enough to staff every layer of modern IT — managed services, networking, cybersecurity, physical security, and video intelligence — but small enough that you reach the engineer who designed your network when you call, not a ticket queue in another time zone. The trade-off is that we won't onboard hundreds of clients a year. That's the point. Our clients get a partner who knows their business by name, not a customer number.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>What kinds of businesses does Blue Cap IT typically work with?</summary>
      <div class="bcit-faq__answer">
        <p>Small and mid-sized businesses across the Mid-Atlantic and Carolinas — typically 10 to 500 employees. We serve professional services firms (law, accounting, consulting), healthcare practices, manufacturers, nonprofits, schools, real estate companies, and businesses in the trades. The common thread isn't industry — it's that our clients want enterprise-grade technology delivered by a partner who actually understands their business, without the bureaucracy of a national MSP.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Why work with Blue Cap IT instead of a large MSP or hiring an internal IT manager?</summary>
      <div class="bcit-faq__answer">
        <p>Three reasons. First, breadth: a single internal IT person can't credibly cover everything from helpdesk to firewall design to physical security to cybersecurity strategy — Blue Cap IT brings specialists in every layer. Second, cost: an experienced internal IT manager runs six figures all-in, which is more than most clients spend on our full managed services. Third, service: large national MSPs run ticket queues across multiple time zones and shuffle accounts between reps; we don't. You get the same engineers every time you call, and you get the technical depth of a big provider without the impersonal experience.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>What partnerships and certifications does Blue Cap IT hold?</summary>
      <div class="bcit-faq__answer">
        <p>Blue Cap IT is a Verkada Gold Partner (physical security), Coro Partner (cybersecurity platform), Huntress Partner (24/7 managed security), spot.ai Partner (AI video intelligence), and Meter Partner (Network as a Service). These are technical partnerships — earned through certified training, demonstrated installation expertise, and ongoing volume — not quota relationships. We deploy and support the full stack ourselves rather than reselling and forwarding tickets.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Where is Blue Cap IT located, and how do you support clients across multiple states?</summary>
      <div class="bcit-faq__answer">
        <p>Blue Cap IT is based in Maryland. We provide on-site service across Maryland, Washington DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina — handling installations, site assessments, and physical security deployments throughout the Mid-Atlantic and Carolinas region. Day-to-day operations (monitoring, helpdesk, patching, cybersecurity, network management) are delivered remotely from our team, so location rarely affects service quality. For cloud-only services like Microsoft 365 management or Coro cybersecurity, we work with businesses anywhere in the United States.</p>
      </div>
    </details>

    <div class="bcit-faq__cta">
      <p><strong>Still have questions?</strong> Call <a href="tel:4108584031">(410) 858-4031</a> or <a href="/contact">request a free assessment</a> — we'd rather listen first and recommend second. Tell us what you're trying to accomplish and we'll show you what fits.</p>
    </div>
  </section>

  <div class="cta-band">
    <div class="section-label">Work With Us</div>
    <h2>Let's Build Your<br/><span class="grad">IT Strategy Together</span></h2>
    <p>Free quote, transparent pricing, no pressure. Tell us what you're trying to accomplish — we'll listen first, recommend second.</p>
    <div class="btn-group">
      <a href="contact.html" class="btn-primary">Get a Free Quote</a>
      <a href="tel:4108584031" class="btn-ghost"><Icon name="lucide:phone" /> (410) 858-4031</a>
      <a href="mailto:info@bluecapit.com" class="btn-ghost"><Icon name="lucide:mail" /> info@bluecapit.com</a>
    </div>
  </div>
</MainLayout>
