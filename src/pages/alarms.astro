---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How is a Verkada alarm system different from a traditional alarm like ADT or Brinks?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Traditional alarm systems are isolated — a separate panel, a separate monitoring contract, and no real connection to your cameras or doors. When something triggers, the monitoring company calls and asks if it's a false alarm. Verkada alarms are built into the same cloud platform as your cameras and access control. When a sensor fires, you instantly see live video from the nearest camera in the same dashboard, the system can verify the threat with AI before escalating, and your team gets mobile alerts with video attached. Same protection, far less noise."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need a separate professional monitoring contract, or does Verkada include it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You have options. The Verkada Alarm Panel (BP52) connects directly to your team via mobile alerts and email — no monitoring contract required. If your insurance, jurisdiction, or industry requires UL-listed professional monitoring with dispatch, Verkada integrates with central station monitoring services. The key difference from a traditional alarm: you're not locked into a monitoring company. We'll talk through what's required for your situation during the free site assessment."
      }
    },
    {
      "@type": "Question",
      "name": "What sensors and devices does Verkada's alarm system support?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The full hardware stack: alarm panels (BP52) and touchscreen keypads, wireless hubs (WH52) for extending range across large facilities, PIR motion sensors (BR32), glass break sensors (BR34), panic buttons (BR33), indoor sirens (BZ11), weatherproof outdoor sirens (BZ32), water leak sensors (BR35) for server rooms and utility areas, and cellular backup communicators for ISP failover. Sensors are wireless and battery-powered for fast installation, and everything reports back to the same Verkada Command dashboard as your cameras and doors."
      }
    },
    {
      "@type": "Question",
      "name": "How does AI video verification reduce false alarms?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When a sensor triggers, Verkada doesn't just send a \"motion detected\" ping — it pulls the camera covering that zone and analyzes the video using AI. If it sees a person where one shouldn't be, you get an alert with the clip attached. If it sees a tree branch waving in the wind or a delivery truck, the system can suppress the alert or hold it for your review. Most traditional alarm callouts are false alarms; visual context dramatically cuts that noise — which means your team responds when it matters and ignores fewer real alerts."
      }
    },
    {
      "@type": "Question",
      "name": "What happens to my alarm system if the internet goes out?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The alarm system keeps working. The BP52 Alarm Panel continues monitoring sensors locally, the sirens still trigger, and the panic buttons still work. The optional Cellular Backup Communicator maintains connectivity to Verkada Command and any monitoring service over LTE/5G, so alerts still reach you and event logs still sync. When the primary internet comes back, everything reconciles automatically. Power loss is handled by battery backup on the panel and individual battery-powered sensors."
      }
    }
  ]
};
---
<MainLayout title="Verkada Alarms | Blue Cap IT — Mid-Atlantic &amp; Carolinas" description="Verkada alarms integrate with cameras &amp; access control — wireless sensors, professional monitoring. Blue Cap IT serves MD, DC, DE, NJ, PA, VA, NC, SC." schema={faqSchema}>
  <div class="inner-hero">
    <div class="section-inner">
      <div class="crumbs"><a href="index.html">Home</a> <span>/</span> <a href="verkada.html">Verkada Solutions</a> <span>/</span> Alarms &amp; Intrusion</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center;">
        <div>
          <div class="section-label">Verkada Solution</div>
          <h1>Alarms &amp; <span class="grad">Intrusion Detection</span></h1>
          <p class="section-sub">A fully integrated alarm system tied directly into your cameras and access control — no isolated panels, no separate monitoring contracts.</p>
          <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap;">
            <a href="contact.html" class="btn-primary">Get a Free Quote</a>
            <a href="tel:4108584031" class="btn-ghost btn-sm"><Icon name="lucide:phone" /> (410) 858-4031</a>
          </div>
        </div>
        <img src="/250916_Alarms_Family_right_Side_2_0030.webp" alt="Verkada Alarm System" class="feature-img" width="1600" height="1066" fetchpriority="high" />
      </div>
    </div>
  </div>

  <!-- VERKADA PARTNER LOGO -->
  <section style="padding:1.5rem 4%;">
    <div class="section-inner" style="text-align:center;padding:0 1.5rem;">
      <img src="/images/verkada-partner.webp" alt="Verkada Authorized Reseller" style="max-height:48px;width:auto;" width="1600" height="226" loading="lazy" decoding="async" />
    </div>
  </section>

  <section>
    <div class="section-inner">
      <div class="feature-list">
        <div class="feature-row">
          <div class="feature-visual"><div class="feature-visual-bg"></div><div class="big-icon"><Icon name="lucide:link" /></div></div>
          <div class="feature-content">
            <h3>Fully Integrated with Cameras &amp; Access</h3>
            <p>Verkada alarms are natively integrated with your camera and access control system. When an alarm triggers, you instantly see live video from the nearest camera — no switching between apps.</p>
            <ul class="feature-bullets">
              <li>Auto-linked camera feed on every alarm event</li>
              <li>Arm/disarm via access credentials or app</li>
              <li>One dashboard for all security functions</li>
              <li>No third-party monitoring service required</li>
              <li>Integrates with professional monitoring if desired</li>
            </ul>
          </div>
        </div>
        <div class="feature-row rev">
          <div class="feature-visual"><div class="feature-visual-bg"></div><div class="big-icon"><Icon name="lucide:smartphone" /></div></div>
          <div class="feature-content">
            <h3>Instant Mobile Alerts</h3>
            <p>When an intrusion is detected, Verkada notifies the right people immediately — with video evidence attached. Respond with context, not just noise.</p>
            <ul class="feature-bullets">
              <li>Push notifications with live video thumbnail</li>
              <li>Configurable alert recipient lists</li>
              <li>Remote arm/disarm from mobile app</li>
              <li>Audio siren and strobe light control</li>
              <li>False alarm reduction via AI video verification</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>


  <section class="specs-section">
    <div class="section-label">Hardware</div>
    <h2>Alarm System <span class="grad">Hardware</span></h2>
    <div class="specs-grid">
      <div class="spec-card">
        <img src="/verkada/alarms/alarm-panel.webp" alt="Verkada Alarm Panel BP52" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="680" loading="lazy" decoding="async" />
        <h4>Alarm Panel (BP52)</h4>
        <p>Central hub that connects all sensors, communicates with the cloud, and triggers responses in real time.</p>
      </div>
      <div class="spec-card">
        <img src="/verkada/alarms/keypad.webp" alt="Verkada Alarm Keypad" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="900" loading="lazy" decoding="async" />
        <h4>Alarm Keypad</h4>
        <p>Touchscreen keypad for arming, disarming, and managing your alarm system on-site.</p>
      </div>
      <div class="spec-card">
        <img src="/verkada/alarms/hub.webp" alt="Verkada Wireless Hub WH52" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="901" loading="lazy" decoding="async" />
        <h4>Wireless Hub (WH52)</h4>
        <p>Extends wireless range to connect sensors across large facilities without additional wiring.</p>
      </div>
      <div class="spec-card">
        <img src="/verkada/alarms/pir-sensor.webp" alt="Verkada PIR Motion Sensor BR32" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="901" loading="lazy" decoding="async" />
        <h4>PIR Motion Sensor (BR32)</h4>
        <p>Detects movement using passive infrared technology, ideal for monitoring rooms and hallways.</p>
      </div>
      <div class="spec-card">
        <img src="/verkada/alarms/glass-break.webp" alt="Verkada Glass Break Sensor BR34" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="901" loading="lazy" decoding="async" />
        <h4>Glass Break Sensor (BR34)</h4>
        <p>Listens for the sound of breaking glass to detect forced entry through windows and glass doors.</p>
      </div>
      <div class="spec-card">
        <img src="/verkada/alarms/panic-button.webp" alt="Verkada Panic Button BR33" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="902" loading="lazy" decoding="async" />
        <h4>Panic Button (BR33)</h4>
        <p>One-press silent or audible alert for emergencies, instantly notifying your security team.</p>
      </div>
      <div class="spec-card">
        <img src="/verkada/alarms/siren.webp" alt="Verkada Indoor Siren BZ11" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="899" loading="lazy" decoding="async" />
        <h4>Indoor Siren (BZ11)</h4>
        <p>Loud audible alarm for indoor spaces, deterring intruders and alerting building occupants.</p>
      </div>
      <div class="spec-card">
        <img src="/verkada/alarms/outdoor-siren.webp" alt="Verkada Outdoor Siren BZ32" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="900" loading="lazy" decoding="async" />
        <h4>Outdoor Siren (BZ32)</h4>
        <p>Weather-resistant siren for exterior mounting, providing high-decibel alerts across your property.</p>
      </div>
      <div class="spec-card">
        <img src="/verkada/alarms/water-leak.webp" alt="Verkada Water Leak Sensor BR35" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="901" loading="lazy" decoding="async" />
        <h4>Water Leak Sensor (BR35)</h4>
        <p>Detects water leaks early to prevent costly damage in server rooms, basements, and utility areas.</p>
      </div>
      <div class="spec-card">
        <img src="/verkada/alarms/cellular-backup.webp" alt="Verkada Cellular Backup Communicator" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="900" loading="lazy" decoding="async" />
        <h4>Cellular Backup Communicator</h4>
        <p>Maintains alarm connectivity over cellular when your primary network goes down, ensuring uninterrupted protection.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bcit-faq" aria-labelledby="alarms-faq-heading">
    <h2 id="alarms-faq-heading" class="bcit-faq__heading">Frequently Asked Questions</h2>
    <p class="bcit-faq__intro">Common questions about Verkada alarm and intrusion detection systems from Blue Cap IT, an official Verkada Gold Partner — alarm panels, motion and glass break sensors, sirens, panic buttons, and cellular backup for businesses across Maryland, DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina.</p>

    <details class="bcit-faq__item">
      <summary>How is a Verkada alarm system different from a traditional alarm like ADT or Brinks?</summary>
      <div class="bcit-faq__answer">
        <p>Traditional alarm systems are isolated — a separate panel, a separate monitoring contract, and no real connection to your cameras or doors. When something triggers, the monitoring company calls and asks if it's a false alarm. Verkada alarms are built into the same cloud platform as your cameras and access control. When a sensor fires, you instantly see live video from the nearest camera in the same dashboard, the system can verify the threat with AI before escalating, and your team gets mobile alerts with video attached. Same protection, far less noise.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Do I need a separate professional monitoring contract, or does Verkada include it?</summary>
      <div class="bcit-faq__answer">
        <p>You have options. The Verkada Alarm Panel (BP52) connects directly to your team via mobile alerts and email — no monitoring contract required. If your insurance, jurisdiction, or industry requires UL-listed professional monitoring with dispatch, Verkada integrates with central station monitoring services. The key difference from a traditional alarm: you're not locked into a monitoring company. We'll talk through what's required for your situation during the free site assessment.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>What sensors and devices does Verkada's alarm system support?</summary>
      <div class="bcit-faq__answer">
        <p>The full hardware stack: alarm panels (BP52) and touchscreen keypads, wireless hubs (WH52) for extending range across large facilities, PIR motion sensors (BR32), glass break sensors (BR34), panic buttons (BR33), indoor sirens (BZ11), weatherproof outdoor sirens (BZ32), water leak sensors (BR35) for server rooms and utility areas, and cellular backup communicators for ISP failover. Sensors are wireless and battery-powered for fast installation, and everything reports back to the same Verkada Command dashboard as your cameras and doors.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>How does AI video verification reduce false alarms?</summary>
      <div class="bcit-faq__answer">
        <p>When a sensor triggers, Verkada doesn't just send a "motion detected" ping — it pulls the camera covering that zone and analyzes the video using AI. If it sees a person where one shouldn't be, you get an alert with the clip attached. If it sees a tree branch waving in the wind or a delivery truck, the system can suppress the alert or hold it for your review. Most traditional alarm callouts are false alarms; visual context dramatically cuts that noise — which means your team responds when it matters and ignores fewer real alerts.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>What happens to my alarm system if the internet goes out?</summary>
      <div class="bcit-faq__answer">
        <p>The alarm system keeps working. The BP52 Alarm Panel continues monitoring sensors locally, the sirens still trigger, and the panic buttons still work. The optional Cellular Backup Communicator maintains connectivity to Verkada Command and any monitoring service over LTE/5G, so alerts still reach you and event logs still sync. When the primary internet comes back, everything reconciles automatically. Power loss is handled by battery backup on the panel and individual battery-powered sensors.</p>
      </div>
    </details>

    <div class="bcit-faq__cta">
      <p><strong>Still have questions?</strong> Call <a href="tel:4108584031">(410) 858-4031</a> or <a href="/contact">request a free alarm assessment</a> — we'll evaluate your facility, recommend the right sensor and panel layout, and quote your full project with itemized pricing.</p>
    </div>
  </section>

  <!-- RELATED SOLUTIONS -->
  <section class="related-links">
    <div class="section-inner">
      <div class="section-label">Explore More Verkada</div>
      <h2>Related Verkada Solutions</h2>
      <div class="related-row">
        <a href="cameras.html" class="btn-ghost">Cameras</a>
        <a href="access-control.html" class="btn-ghost">Access Control</a>
        <a href="sensors.html" class="btn-ghost">Sensors</a>
        <a href="intercom.html" class="btn-ghost">Intercom</a>
        <a href="command.html" class="btn-ghost">Command Platform</a>
        <a href="command-connector.html" class="btn-ghost">Command Connector</a>
        <a href="workplace.html" class="btn-ghost">Workplace</a>
        <a href="connectivity.html" class="btn-ghost">Connectivity</a>
        <a href="verkada.html" class="btn-ghost">All Verkada Solutions</a>
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div class="section-label">Secure Your Perimeter</div>
    <h2>Integrated Alarms, Installed by<br/><span class="grad">Blue Cap IT</span></h2>
    <p>We design, install, and configure Verkada alarm systems that work seamlessly with your existing cameras and access control.</p>
    <div class="btn-group">
      <a href="contact.html" class="btn-primary">Get a Free Quote</a>
      <a href="tel:4108584031" class="btn-ghost"><Icon name="lucide:phone" /> (410) 858-4031</a>
      <a href="mailto:info@bluecapit.com" class="btn-ghost"><Icon name="lucide:mail" /> info@bluecapit.com</a>
    </div>
  </div>
</MainLayout>
