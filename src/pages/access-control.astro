      <div class="section-label">Explore More Verkada</div>
      <h2>Related Verkada Solutions</h2>
      <div class="related-row">
        <a href="cameras.html" class="btn-ghost">Cameras</a>
        <a href="alarms.html" class="btn-ghost">Alarms</a>
        <a href="sensors.html" class="btn-ghost">Sensors</a>
        <a href="intercom.html" class="btn-ghost">Intercom</a>
        <a href="command.html" class="btn-ghost">Command Platform</a>
        <a href="command-connector.html" class="btn-ghost">Command Connector</a>
        <a href="workplace.html" class="btn-ghost">Workplace</a>
        <a href="connectivity.html" class="btn-ghost">Connectivity</a>
        <a href="verkada.html" class="btn-ghost">All Verkada Solutions</a>
      </div>
    </div>
  </section>

  <div class="cta-band">
    <div class="section-label">Secure Your Doors</div>
    <h2>Start with a Free <span class="grad">Access Control Assessment</span></h2>
