---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Huntress, and how is it different from traditional antivirus?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Huntress is a managed cybersecurity platform that combines lightweight software agents with a 24/7 human Security Operations Center. Traditional antivirus tries to block known malware signatures and stops when something gets past the filter. Huntress assumes attackers will get in — and watches for the behaviors they exhibit after a breach (persistence mechanisms, lateral movement, credential theft, ransomware staging). When real threats are confirmed, Huntress contains and remediates them on your behalf — endpoints are isolated, malicious processes killed, and damage is prevented before it spreads."
      }
    },
    {
      "@type": "Question",
      "name": "What does it mean that Huntress is \"SOC-backed,\" and what is a SOC?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A SOC is a Security Operations Center — a team of dedicated analysts who monitor security alerts around the clock, separate real threats from false positives, and respond to incidents in real time. Most small and mid-sized businesses can't afford to staff a SOC internally (24/7 coverage requires roughly 8-10 analysts at $150K+ each). Huntress runs the SOC for you as part of every subscription. When an alert fires at 3 AM on a Sunday, a real human analyst at Huntress is the one investigating it — not your team."
      }
    },
    {
      "@type": "Question",
      "name": "How does Huntress achieve an 8-minute mean time to respond?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mean Time to Respond (MTTR) measures how long it takes from when a threat is detected to when it's actively contained. Huntress hits 8 minutes through a combination of AI-assisted triage (flagging high-confidence threats automatically), pre-approved response playbooks (the SOC can isolate endpoints and kill processes without waiting for your approval on textbook attacks), and 24/7 staffing of senior analysts. For context: industry average MTTR is measured in hours or days. The 8-minute number is what consistently keeps a single compromised laptop from turning into ransomware across your whole network."
      }
    },
    {
      "@type": "Question",
      "name": "How is Huntress different from Coro, and do I need both?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Coro is a unified cybersecurity software platform — it automates protection across endpoints, email, cloud apps, and network from one agent. Huntress is the 24/7 human SOC that watches for threats Coro (or any other tool) might miss, especially the targeted attacks designed to evade automated systems. Many of our clients run both: Coro as the broad platform handling routine threats automatically, Huntress as the SOC handling the hard cases — targeted intrusions, identity compromise, and active incidents. Call (410) 858-4031 and we'll walk through which combination fits your risk profile and budget."
      }
    },
    {
      "@type": "Question",
      "name": "Do we need our own security team to use Huntress, or does Blue Cap IT manage it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You don't need a security team. Huntress is designed to run without one — the SOC handles detection and response, and Blue Cap IT handles deployment, agent rollouts, integration with Microsoft 365 and Google Workspace, policy tuning, and incident communication. When something happens, you get a clear written incident report from us explaining what was detected, what was done about it, and what (if anything) you need to act on. No security jargon, no fire drills."
      }
    }
  ]
};
---
<MainLayout ogImage="/images/huntress-hero.webp" title="Huntress Managed Security | Blue Cap IT — Mid-Atlantic &amp; Carolinas" description="24/7 SOC-backed Huntress security from Blue Cap IT — managed EDR, ITDR, SIEM, awareness training — across MD, DC, DE, NJ, PA, VA, NC, SC." schema={faqSchema}>
  <div class="inner-hero">
    <div class="section-inner">
      <img src="/images/huntress-hero.webp" alt="Security operations center analyst monitoring a wall of dashboards and surveillance feeds" style="width:100%;height:auto;max-height:340px;object-fit:cover;border-radius:1rem;margin-bottom:2rem;box-shadow:0 8px 32px rgba(0,0,0,0.2);" width="1600" height="1200" fetchpriority="high" />
      <div class="crumbs"><a href="index.html">Home</a> <span>/</span> Huntress</div>
      <div class="section-label">Huntress Partner</div>
      <h1>Managed Security. <span class="grad">24/7 Protection.</span></h1>
      <p class="section-sub">Blue Cap IT partners with Huntress to deliver SOC-backed cybersecurity that finds and stops hackers before they cause damage. Managed EDR, identity threat detection, SIEM, and security awareness training — all powered by a 24/7 Security Operations Center with an industry-leading 8-minute mean time to respond.</p>
    </div>
  </div>

  <!-- HUNTRESS LOGO -->
  <section style="padding:1.5rem 4%;">
    <div class="section-inner" style="text-align:center;padding:0 1.5rem;">
      <img src="/Huntress/huntress-logo-teal.webp" alt="Huntress" style="max-height:60px;width:auto;" width="1600" height="394" loading="lazy" decoding="async" />
    </div>
  </section>

  <!-- WHY HUNTRESS -->
  <section>
    <div class="section-inner">
      <div class="why-grid">
        <div>
          <div class="section-label">Why Huntress</div>
          <h2>Hackers Don't Sleep.<br/><span class="grad">Neither Does Huntress.</span></h2>
          <p class="section-sub">Most cybersecurity tools generate alerts — Huntress actually stops threats. Their 24/7 AI-assisted Security Operations Center investigates every alert, eliminates false positives, and remediates real threats before they cause damage. No alert fatigue. No missed attacks.</p>
          <p class="section-sub" style="margin-top:1rem;">As a Huntress Partner, Blue Cap IT deploys and manages the full Huntress platform for you — so you get enterprise-grade threat detection and response without needing an in-house security team.</p>
          <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap;">
            <a href="contact.html" class="btn-primary">Get a Free Quote</a>
            <a href="tel:4108584031" class="btn-ghost">Call (410) 858-4031</a>
          </div>
        </div>
        <ul class="why-list">
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:target" /></div>
            <div><h4>24/7 SOC-Backed Protection</h4><p>A world-class Security Operations Center monitors your environment around the clock — investigating threats, eliminating false positives, and responding in minutes, not hours.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:zap" /></div>
            <div><h4>8-Minute Mean Time to Respond</h4><p>Industry-leading response times mean threats are contained and remediated before hackers can move laterally or cause damage.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:trophy" /></div>
            <div><h4>Award-Winning Platform</h4><p>Winner of the 2026 SC Award for Best Managed Detection and Response Service. Purpose-built for businesses like yours.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:wrench" /></div>
            <div><h4>Fully Managed by Blue Cap IT</h4><p>We deploy, configure, and manage Huntress for you. You get complete protection with zero added complexity to your team.</p></div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- IMAGE BAND -->
  <section style="padding:0 4% 4rem;">
    <div style="max-width:1100px;margin:0 auto;">
      <img src="/images/huntress-platform.webp" alt="Hooded SOC analyst working at a dark workstation with multiple monitors" style="width:100%;height:auto;max-height:380px;object-fit:cover;border-radius:1rem;box-shadow:0 8px 32px rgba(0,0,0,0.2);" width="1600" height="1067" loading="lazy" decoding="async" />
    </div>
  </section>

  <!-- PRODUCT LINES -->
  <section style="background:var(--surface);">
    <div class="section-inner">
      <div style="text-align:center;max-width:640px;margin:0 auto 2rem;">
        <div class="section-label">Huntress Platform</div>
        <h2>Complete Protection.<br/><span class="grad">One Platform.</span></h2>
        <p class="section-sub" style="margin:0.8rem auto 0;text-align:center;">Huntress combines endpoint protection, identity security, log management, and human risk reduction into one unified, SOC-managed platform.</p>
      </div>
      <div class="products-grid" style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr));max-width:1000px;margin:0 auto;">
        <a href="huntress-edr.html" class="product-card" style="text-decoration:none;color:inherit;">
          <div class="pcard-icon"><Icon name="lucide:laptop" /></div>
          <h3>Managed EDR</h3>
          <p>24/7 endpoint detection and response with a lightweight agent, behavioral analytics, and automated threat remediation. The SOC handles everything from detection to cleanup.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
        <a href="huntress-itdr.html" class="product-card" style="text-decoration:none;color:inherit;">
          <div class="pcard-icon"><Icon name="lucide:lock-keyhole" /></div>
          <h3>Managed ITDR</h3>
          <p>Identity threat detection and response for Microsoft 365 and Google Workspace. Stops account takeovers, business email compromise, and unauthorized access in 3 minutes.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
        <a href="huntress-siem.html" class="product-card" style="text-decoration:none;color:inherit;">
          <div class="pcard-icon"><Icon name="lucide:bar-chart-3" /></div>
          <h3>Managed SIEM</h3>
          <p>Security information and event management without the complexity. 24/7 threat response and compliance reporting, fully managed by SOC experts at a predictable price.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
        <a href="huntress-sat.html" class="product-card" style="text-decoration:none;color:inherit;">
          <div class="pcard-icon"><Icon name="lucide:graduation-cap" /></div>
          <h3>Security Awareness Training</h3>
          <p>Engaging, expert-backed training built on real-world threat intelligence. Hands-on simulations and gamification that make cybersecurity concepts stick.</p>
          <span class="pcard-arrow">Learn more →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section>
    <div class="section-inner">
      <div style="text-align:center;max-width:640px;margin:0 auto 2rem;">
        <div class="section-label">How It Works</div>
        <h2>Detect. Respond. <span class="grad">Remediate.</span></h2>
        <p class="section-sub" style="margin:0.8rem auto 0;text-align:center;">Huntress doesn't just alert you to threats — it eliminates them. Here's how the platform protects your business around the clock.</p>
      </div>
      <div class="products-grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
        <div class="product-card" style="text-align:center;">
          <div class="pcard-icon"><Icon name="lucide:search" /></div>
          <h3>1. Continuous Monitoring</h3>
          <p>Lightweight agents and cloud integrations monitor your endpoints, identities, and logs 24/7 for suspicious activity.</p>
        </div>
        <div class="product-card" style="text-align:center;">
          <div class="pcard-icon"><Icon name="lucide:bot" /></div>
          <h3>2. AI + Human Analysis</h3>
          <p>AI-assisted detection flags potential threats. Human SOC analysts validate every alert — eliminating false positives and identifying real attacks.</p>
        </div>
        <div class="product-card" style="text-align:center;">
          <div class="pcard-icon"><Icon name="lucide:shield" /></div>
          <h3>3. Rapid Response</h3>
          <p>Confirmed threats are contained and remediated in minutes. Compromised endpoints are isolated, malicious processes are killed, and damage is prevented.</p>
        </div>
        <div class="product-card" style="text-align:center;">
          <div class="pcard-icon"><Icon name="lucide:clipboard-list" /></div>
          <h3>4. Detailed Reporting</h3>
          <p>You get clear, actionable incident reports explaining what happened, what was done, and what to watch for — no jargon, no guesswork.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bcit-faq" aria-labelledby="huntress-faq-heading">
    <h2 id="huntress-faq-heading" class="bcit-faq__heading">Frequently Asked Questions</h2>
    <p class="bcit-faq__intro">Common questions about Huntress managed cybersecurity from Blue Cap IT — Managed EDR, Identity Threat Detection (ITDR), SIEM, and Security Awareness Training — for businesses across Maryland, DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina.</p>

    <details class="bcit-faq__item">
      <summary>What is Huntress, and how is it different from traditional antivirus?</summary>
      <div class="bcit-faq__answer">
        <p>Huntress is a managed cybersecurity platform that combines lightweight software agents with a 24/7 human Security Operations Center. Traditional antivirus tries to block known malware signatures and stops when something gets past the filter. Huntress assumes attackers will get in — and watches for the behaviors they exhibit after a breach (persistence mechanisms, lateral movement, credential theft, ransomware staging). When real threats are confirmed, Huntress contains and remediates them on your behalf — endpoints are isolated, malicious processes killed, and damage is prevented before it spreads.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>What does it mean that Huntress is "SOC-backed," and what is a SOC?</summary>
      <div class="bcit-faq__answer">
        <p>A SOC is a Security Operations Center — a team of dedicated analysts who monitor security alerts around the clock, separate real threats from false positives, and respond to incidents in real time. Most small and mid-sized businesses can't afford to staff a SOC internally (24/7 coverage requires roughly 8-10 analysts at $150K+ each). Huntress runs the SOC for you as part of every subscription. When an alert fires at 3 AM on a Sunday, a real human analyst at Huntress is the one investigating it — not your team.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>How does Huntress achieve an 8-minute mean time to respond?</summary>
      <div class="bcit-faq__answer">
        <p>Mean Time to Respond (MTTR) measures how long it takes from when a threat is detected to when it's actively contained. Huntress hits 8 minutes through a combination of AI-assisted triage (flagging high-confidence threats automatically), pre-approved response playbooks (the SOC can isolate endpoints and kill processes without waiting for your approval on textbook attacks), and 24/7 staffing of senior analysts. For context: industry average MTTR is measured in hours or days. The 8-minute number is what consistently keeps a single compromised laptop from turning into ransomware across your whole network.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>How is Huntress different from Coro, and do I need both?</summary>
      <div class="bcit-faq__answer">
        <p>Coro is a unified cybersecurity software platform — it automates protection across endpoints, email, cloud apps, and network from one agent. Huntress is the 24/7 human SOC that watches for threats Coro (or any other tool) might miss, especially the targeted attacks designed to evade automated systems. Many of our clients run both: Coro as the broad platform handling routine threats automatically, Huntress as the SOC handling the hard cases — targeted intrusions, identity compromise, and active incidents. Call (410) 858-4031 and we'll walk through which combination fits your risk profile and budget.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Do we need our own security team to use Huntress, or does Blue Cap IT manage it?</summary>
      <div class="bcit-faq__answer">
        <p>You don't need a security team. Huntress is designed to run without one — the SOC handles detection and response, and Blue Cap IT handles deployment, agent rollouts, integration with Microsoft 365 and Google Workspace, policy tuning, and incident communication. When something happens, you get a clear written incident report from us explaining what was detected, what was done about it, and what (if anything) you need to act on. No security jargon, no fire drills.</p>
      </div>
    </details>

    <div class="bcit-faq__cta">
      <p><strong>Still have questions?</strong> Call <a href="tel:4108584031">(410) 858-4031</a> or <a href="/contact">request a free security assessment</a> — we'll evaluate your current posture, identify gaps, and recommend the Huntress modules (and optional Coro platform) that fit your business.</p>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:var(--surface);">
    <div class="section-inner" style="text-align:center;padding:4rem 1.5rem;">
      <div class="section-label">Get Started</div>
      <h2>Ready for <span class="grad">24/7 Protection?</span></h2>
      <p class="section-sub" style="max-width:600px;margin:0.8rem auto 2rem;text-align:center;">Contact Blue Cap IT to get Huntress deployed across your organization. We'll assess your security posture and show you how Huntress can protect your business around the clock.</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href="contact.html" class="btn-primary">Get a Free Quote</a>
        <a href="tel:4108584031" class="btn-ghost">Call (410) 858-4031</a>
      </div>
    </div>
  </section>
</MainLayout>
