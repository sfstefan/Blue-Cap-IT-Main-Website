---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How is the Meter 5G Gateway different from Verkada's cellular gateway?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Different scope. The Verkada GC31/GC31-E gateway is dedicated to keeping Verkada physical security devices (cameras, access control, alarms, sensors) online — typically a few devices and modest bandwidth. The Meter 5G Gateway is an enterprise WAN backup for your entire office network — workstations, voice, video calls, cloud apps, POS systems, all the traffic flowing through your firewall. It delivers up to 1200 Mbps, integrates with the rest of your Meter network for SD-WAN routing, and supports out-of-band management. Many clients run both at the same site: Meter Gateway for the office, Verkada gateway for physical security continuity."
      }
    },
    {
      "@type": "Question",
      "name": "How fast is 5G in practice — can it really run my whole business?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For most mid-sized businesses, yes. The Meter Gateway delivers up to 1200 Mbps over 5G — comparable to fiber for many client environments. Real-world performance depends on carrier coverage and signal strength at your specific location, which we measure during the site assessment. As a rough guide: if your office runs comfortably on 500-1000 Mbps of wired internet, 5G failover will keep things running with minimal user impact. Video calls, cloud apps, email, file sync, and POS all work normally. The bigger concern is usually data cost, not speed."
      }
    },
    {
      "@type": "Question",
      "name": "What is \"out-of-band management,\" and why does it matter?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Out-of-band management is a separate communication path Meter uses to reach your network when your primary internet is down — over the cellular connection of the Gateway. Without it, if your main ISP goes out and your firewall or switch has a configuration issue at the same time, your IT partner can't remotely fix it — someone has to drive to the site. With out-of-band, Meter (and Blue Cap IT) can log in, diagnose, and resolve problems even when the office is completely offline from the wired internet. For multi-site businesses and remote locations, this turns multi-hour outages into minutes."
      }
    },
    {
      "@type": "Question",
      "name": "How is cellular data priced — do I pay per GB?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Gateway's cellular service is provided through Meter's bundled carrier relationships and included in the Network as a Service subscription — no separate carrier bill, no overage surprises. Heavy continuous use (running on cellular as primary for weeks) has reasonable usage tiers, but typical failover use (the wired ISP drops for a few hours per month) is well within the included data. We'll size the right plan during the assessment based on whether you're using it as backup, primary, or somewhere in between."
      }
    },
    {
      "@type": "Question",
      "name": "Can the Meter Gateway be the primary internet for a site, or only a backup?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Both. For sites without wired internet — construction trailers, pop-up retail, remote facilities, temporary offices, warehouses where running fiber doesn't make sense — the Meter Gateway can serve as the primary WAN connection. Up to 1200 Mbps over 5G is genuinely enough bandwidth to run office operations. For traditional offices, it's typically deployed as a failover backup to a wired ISP. The hardware is the same; the configuration adapts to whichever role fits your site."
      }
    }
  ]
};
---
<MainLayout title="Meter 5G Gateway | Blue Cap IT — Mid-Atlantic &amp; Carolinas" description="Meter 5G Gateway — up to 1200 Mbps cellular WAN with automatic ISP failover. Blue Cap IT serves MD, DC, DE, NJ, PA, VA, NC, SC." schema={faqSchema}>
  <div class="inner-hero">
    <div class="section-inner">
      <img src="/meter/Meter-purple.png" alt="Meter" style="max-height:60px;width:auto;margin-bottom:1.5rem;"/>
      <div class="crumbs"><a href="index.html">Home</a> <span>/</span> <a href="meter.html">Networking</a> <span>/</span> 5G Gateway</div>
      <div class="section-label">Meter Hardware</div>
      <h1>Meter <span class="grad">5G Gateway</span></h1>
      <p class="section-sub">Never lose connectivity again. The Meter Gateway delivers up to 1200Mbps over 5G, providing automatic ISP failover, out-of-band management, and backup connectivity for your most critical locations — even in harsh, rugged environments.</p>
    </div>
  </div>

  <!-- GATEWAY FEATURES -->
  <section>
    <div class="section-inner">
      <div class="why-grid">
        <div>
          <img src="/meter/hw-p-series.avif" alt="Meter 5G Gateway" style="width:100%;max-width:500px;border-radius:0.75rem;margin-bottom:1.5rem;" />
          <div class="section-label">G-Series Gateway</div>
          <h2>Always-On <span class="grad">Connectivity.</span></h2>
          <p class="section-sub">When your primary ISP goes down, the Meter Gateway automatically kicks in over 5G cellular — keeping your business connected, your devices online, and your operations running. It also provides out-of-band management, so Meter can remotely access and troubleshoot your network even when the primary internet connection is unavailable.</p>
          <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap;">
            <a href="contact.html" class="btn-primary">Get a Free Quote</a>
            <a href="tel:4108584031" class="btn-ghost">Call (410) 858-4031</a>
          </div>
        </div>
        <ul class="why-list">
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:radio-tower" /></div>
            <div><h4>5G Cellular Connectivity</h4><p>Up to 1200Mbps throughput over 5G. Fast enough to keep your business running at full speed even without a wired ISP connection.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:refresh-cw" /></div>
            <div><h4>Automatic ISP Failover</h4><p>When your primary internet goes down, the Gateway detects the outage and switches to 5G automatically — no manual intervention, no downtime.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:wrench" /></div>
            <div><h4>Out-of-Band Management</h4><p>Meter can remotely access, diagnose, and fix your network over the cellular connection — even when your main internet is completely offline.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:mountain" /></div>
            <div><h4>Rugged &amp; Reliable</h4><p>Built to operate in harsh and rugged environments. The Gateway is designed for remote sites, construction locations, warehouses, and outdoor deployments.</p></div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- USE CASES -->
  <section style="background:var(--surface);">
    <div class="section-inner">
      <div style="text-align:center;max-width:640px;margin:0 auto 2rem;">
        <div class="section-label">Use Cases</div>
        <h2>Where the Gateway <span class="grad">Shines</span></h2>
        <p class="section-sub" style="margin:0.8rem auto 0;text-align:center;">The Meter Gateway is ideal for any location where reliable connectivity is critical — or where wired internet simply isn't available.</p>
      </div>
      <div class="products-grid" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
        <div class="product-card" style="text-align:center;">
          <div class="pcard-icon"><Icon name="lucide:building-2" /></div>
          <h3>Primary ISP Backup</h3>
          <p>Add a 5G backup to any office or facility. If your wired ISP goes down, the Gateway keeps your business online automatically.</p>
        </div>
        <div class="product-card" style="text-align:center;">
          <div class="pcard-icon"><Icon name="lucide:layers" /></div>
          <h3>Remote &amp; Temporary Sites</h3>
          <p>Construction sites, pop-up locations, and temporary offices where running fiber isn't practical. Get enterprise networking over 5G.</p>
        </div>
        <div class="product-card" style="text-align:center;">
          <div class="pcard-icon"><Icon name="lucide:factory" /></div>
          <h3>Warehouses &amp; Facilities</h3>
          <p>Large facilities where wired connectivity is unreliable or expensive to extend. The Gateway provides coverage where cables can't reach.</p>
        </div>
        <div class="product-card" style="text-align:center;">
          <div class="pcard-icon"><Icon name="lucide:store" /></div>
          <h3>Retail &amp; Branch Offices</h3>
          <p>Multi-location businesses that need guaranteed uptime at every site. Keep point-of-sale, security cameras, and operations running 24/7.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bcit-faq" aria-labelledby="meter-gateway-faq-heading">
    <h2 id="meter-gateway-faq-heading" class="bcit-faq__heading">Frequently Asked Questions</h2>
    <p class="bcit-faq__intro">Common questions about the Meter 5G Gateway from Blue Cap IT — up to 1200 Mbps cellular WAN, automatic ISP failover, and out-of-band management for businesses across Maryland, DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina.</p>

    <details class="bcit-faq__item">
      <summary>How is the Meter 5G Gateway different from Verkada's cellular gateway?</summary>
      <div class="bcit-faq__answer">
        <p>Different scope. The Verkada GC31/GC31-E gateway is dedicated to keeping Verkada physical security devices (cameras, access control, alarms, sensors) online — typically a few devices and modest bandwidth. The Meter 5G Gateway is an enterprise WAN backup for your entire office network — workstations, voice, video calls, cloud apps, POS systems, all the traffic flowing through your firewall. It delivers up to 1200 Mbps, integrates with the rest of your Meter network for SD-WAN routing, and supports out-of-band management. Many clients run both at the same site: Meter Gateway for the office, Verkada gateway for physical security continuity.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>How fast is 5G in practice — can it really run my whole business?</summary>
      <div class="bcit-faq__answer">
        <p>For most mid-sized businesses, yes. The Meter Gateway delivers up to 1200 Mbps over 5G — comparable to fiber for many client environments. Real-world performance depends on carrier coverage and signal strength at your specific location, which we measure during the site assessment. As a rough guide: if your office runs comfortably on 500-1000 Mbps of wired internet, 5G failover will keep things running with minimal user impact. Video calls, cloud apps, email, file sync, and POS all work normally. The bigger concern is usually data cost, not speed.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>What is "out-of-band management," and why does it matter?</summary>
      <div class="bcit-faq__answer">
        <p>Out-of-band management is a separate communication path Meter uses to reach your network when your primary internet is down — over the cellular connection of the Gateway. Without it, if your main ISP goes out and your firewall or switch has a configuration issue at the same time, your IT partner can't remotely fix it — someone has to drive to the site. With out-of-band, Meter (and Blue Cap IT) can log in, diagnose, and resolve problems even when the office is completely offline from the wired internet. For multi-site businesses and remote locations, this turns multi-hour outages into minutes.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>How is cellular data priced — do I pay per GB?</summary>
      <div class="bcit-faq__answer">
        <p>The Gateway's cellular service is provided through Meter's bundled carrier relationships and included in the Network as a Service subscription — no separate carrier bill, no overage surprises. Heavy continuous use (running on cellular as primary for weeks) has reasonable usage tiers, but typical failover use (the wired ISP drops for a few hours per month) is well within the included data. We'll size the right plan during the assessment based on whether you're using it as backup, primary, or somewhere in between.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Can the Meter Gateway be the primary internet for a site, or only a backup?</summary>
      <div class="bcit-faq__answer">
        <p>Both. For sites without wired internet — construction trailers, pop-up retail, remote facilities, temporary offices, warehouses where running fiber doesn't make sense — the Meter Gateway can serve as the primary WAN connection. Up to 1200 Mbps over 5G is genuinely enough bandwidth to run office operations. For traditional offices, it's typically deployed as a failover backup to a wired ISP. The hardware is the same; the configuration adapts to whichever role fits your site.</p>
      </div>
    </details>

    <div class="bcit-faq__cta">
      <p><strong>Still have questions?</strong> Call <a href="tel:4108584031">(410) 858-4031</a> or <a href="/contact">request a free network resilience assessment</a> — we'll check 5G coverage at your sites, evaluate failover needs, and quote the Meter Gateway as part of your full NaaS deployment with itemized pricing.</p>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="section-inner" style="text-align:center;padding:4rem 1.5rem;">
      <h2>Never Go Offline <span class="grad">Again</span></h2>
      <p class="section-sub" style="max-width:600px;margin:0.8rem auto 2rem;text-align:center;">Contact Blue Cap IT to add 5G failover to your network. We'll assess your connectivity needs and design a solution that keeps you online no matter what.</p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a href="contact.html" class="btn-primary">Get a Free Quote</a>
        <a href="tel:4108584031" class="btn-ghost">Call (410) 858-4031</a>
      </div>
    </div>
  </section>
</MainLayout>
