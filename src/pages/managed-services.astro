---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What's included in Blue Cap IT's managed IT services?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A flat monthly subscription covers 24/7 remote monitoring, unlimited helpdesk support for your employees, automated patch management across operating systems and applications, backup and disaster recovery, Microsoft 365 administration (user provisioning, security, licensing), network management for firewalls and Wi-Fi, and optional Virtual CIO (vCIO) services for strategic planning. Hardware refreshes, software audits, and quarterly business reviews are built in."
      }
    },
    {
      "@type": "Question",
      "name": "How does Blue Cap IT price managed IT services?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Pricing is per-user or per-device on a flat monthly subscription — not hourly. You know your IT cost going into each month, and we make money when your systems run smoothly, not when they break. Final pricing depends on your environment size, number of servers, and which add-ons you need (vCIO, advanced backup, cybersecurity through Coro or Huntress). We'll quote your specific situation after a free assessment."
      }
    },
    {
      "@type": "Question",
      "name": "How quickly does Blue Cap IT respond to support tickets?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Within minutes — for both critical issues (systems down, email out, suspected ransomware) and routine requests (password resets, software questions, hardware issues). Our 24/7 monitoring often catches problems before your team even notices, so we can fix things before they hit your ticket queue."
      }
    },
    {
      "@type": "Question",
      "name": "Can Blue Cap IT support remote employees and hybrid teams?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Our remote monitoring agents and helpdesk work the same whether your team is in the office, at home, or split. We secure remote endpoints, configure VPN and Zero Trust access, manage Microsoft 365 and cloud apps, and provide the same fast support regardless of where your employees sit. Most of our clients today run hybrid or fully remote operations."
      }
    },
    {
      "@type": "Question",
      "name": "Is cybersecurity included in managed IT, or is it a separate service?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Baseline cybersecurity — patch management, secure backups, Microsoft 365 security configuration, antivirus, and identity hygiene — is part of managed IT. For deeper protection like Managed Detection and Response (MDR), 24/7 SOC monitoring, endpoint behavioral analysis, email threat protection, and security awareness training, we add Coro or Huntress on top. Most clients combine both. Call (410) 858-4031 to talk through what level of protection you need."
      }
    }
  ]
};
---
<MainLayout ogImage="/images/managed-services-hero.webp" title="Managed IT Services | Blue Cap IT — Mid-Atlantic &amp; Carolinas" description="Outsourced IT from Blue Cap IT — helpdesk, monitoring, patching, backup, M365, vCIO. Serving businesses across MD, DC, DE, NJ, PA, VA, NC, SC." schema={faqSchema}>
  <div class="inner-hero">
    <div class="section-inner">
      <img src="/images/managed-services-hero.webp" alt="Real-time monitoring dashboard showing IT service metrics and analytics" style="width:100%;height:auto;max-height:340px;object-fit:cover;border-radius:1rem;margin-bottom:2rem;box-shadow:0 8px 32px rgba(0,0,0,0.2);" width="1600" height="1152" fetchpriority="high" />
      <div class="crumbs"><a href="index.html">Home</a> <span>/</span> Managed IT Services</div>
      <div class="section-label">Managed Service Provider</div>
      <h1>Managed IT <span class="grad">Services</span></h1>
      <p class="section-sub">Blue Cap IT acts as your complete outsourced IT department. We proactively monitor, manage, and support your entire technology environment — so you can focus on running your business.</p>
    </div>
  </div>

  <!-- WHY MANAGED IT -->
  <section>
    <div class="section-inner">
      <div class="why-grid">
        <div>
          <div class="section-label">Why Managed IT</div>
          <h2>Proactive IT Management.<br/><span class="grad">Not Break-Fix.</span></h2>
          <p class="section-sub">Instead of waiting for things to break, Blue Cap IT continuously monitors your systems, applies updates, and resolves issues before they impact your team. You get enterprise-level IT support at a predictable monthly cost.</p>
          <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap;">
            <a href="contact.html" class="btn-primary">Get a Free Quote</a>
            <a href="tel:4108584031" class="btn-ghost">Call (410) 858-4031</a>
          </div>
        </div>
        <ul class="why-list">
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:bar-chart-3" /></div>
            <div><h4>24/7 Monitoring</h4><p>We monitor your servers, workstations, and network devices around the clock. If something goes wrong, we know about it before you do.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:wallet" /></div>
            <div><h4>Predictable Costs</h4><p>Flat monthly pricing means no surprise IT bills. Budget confidently with a clear, transparent cost structure.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:rocket" /></div>
            <div><h4>Reduced Downtime</h4><p>Proactive maintenance and rapid response keep your team productive and your systems running smoothly.</p></div>
          </li>
          <li class="why-item">
            <div class="why-icon"><Icon name="lucide:handshake" /></div>
            <div><h4>A True IT Partner</h4><p>We're not just a vendor — we're an extension of your team. We learn your business and align technology with your goals.</p></div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SERVICE CARDS -->
  <section id="services" style="background:var(--surface);">
    <div class="section-inner">
      <div style="text-align:center;max-width:640px;margin:0 auto 2rem;">
        <div class="section-label">Our Managed IT Services</div>
        <h2>Everything Your Business Needs.<br/><span class="grad">One Provider.</span></h2>
      </div>
      <div class="products-grid">
        <div id="rmm" class="product-card">
          <div class="pcard-icon"><Icon name="lucide:activity" /></div>
          <h3>Remote Monitoring &amp; Management</h3>
          <p>24/7 monitoring of your servers, workstations, and network devices. We detect and resolve issues proactively — often before your team even notices a problem.</p>
        </div>
        <div id="helpdesk" class="product-card">
          <div class="pcard-icon"><Icon name="lucide:headphones" /></div>
          <h3>Helpdesk Support</h3>
          <p>Your employees get fast, friendly IT support when they need it. Whether it's a password reset, software issue, or hardware question — we're a phone call or email away.</p>
        </div>
        <div id="patching" class="product-card">
          <div class="pcard-icon"><Icon name="lucide:refresh-cw" /></div>
          <h3>Patch Management</h3>
          <p>We keep your operating systems, applications, and firmware up to date with the latest security patches. Automated, tested, and applied on a schedule that works for your business.</p>
        </div>
        <div id="backup" class="product-card">
          <div class="pcard-icon"><Icon name="lucide:database-backup" /></div>
          <h3>Backup &amp; Disaster Recovery</h3>
          <p>Automated backups with tested recovery procedures. Your data is protected and recoverable — whether it's a deleted file or a full system failure.</p>
        </div>
        <div id="microsoft-365" class="product-card">
          <div class="pcard-icon"><Icon name="lucide:cloud" /></div>
          <h3>Microsoft 365 Management</h3>
          <p>We manage your Microsoft 365 environment — Exchange Online, Teams, SharePoint, OneDrive, and licensing. User provisioning, security configuration, and ongoing administration handled for you.</p>
        </div>
        <div id="network" class="product-card">
          <div class="pcard-icon"><Icon name="lucide:globe" /></div>
          <h3>Network Management</h3>
          <p>Firewalls, switches, Wi-Fi, and VPN — we design, deploy, and manage your network infrastructure to keep your business connected and secure.</p>
        </div>
        <div id="vcio" class="product-card">
          <div class="pcard-icon"><Icon name="lucide:brain" /></div>
          <h3>Virtual CIO (vCIO) Services</h3>
          <p>Get strategic IT leadership without the cost of a full-time executive. We help you plan technology roadmaps, set IT budgets, evaluate vendors, and align technology with your business goals.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- vCIO DETAIL SECTION -->
  <section>
    <div class="section-inner">
      <div class="feature-row">
        <img src="/images/managed-services-vcio.webp" alt="Hands at a keyboard beside a desktop monitor during a working session" style="width:100%;height:100%;max-height:400px;object-fit:cover;border-radius:1rem;box-shadow:0 8px 32px rgba(0,0,0,0.2);" width="1600" height="306" loading="lazy" decoding="async" />
        <div class="feature-text">
          <div class="section-label">Strategic IT Leadership</div>
          <h2>Virtual CIO <span class="grad">Services</span></h2>
          <p>Not every business needs a full-time CIO — but every business needs a technology strategy. Blue Cap IT's vCIO services give you an experienced IT leader who understands your business and helps you make smart technology decisions.</p>
          <ul class="feature-bullets">
            <li>Technology roadmap planning and budgeting</li>
            <li>Vendor evaluation and management</li>
            <li>IT policy development and compliance guidance</li>
            <li>Quarterly business reviews and reporting</li>
            <li>Strategic guidance for growth and scaling</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bcit-faq" aria-labelledby="managed-services-faq-heading">
    <h2 id="managed-services-faq-heading" class="bcit-faq__heading">Frequently Asked Questions</h2>
    <p class="bcit-faq__intro">Common questions about Blue Cap IT's managed IT services — remote monitoring, helpdesk, patching, backup, Microsoft 365, network management, and vCIO — for businesses across Maryland, DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina.</p>

    <details class="bcit-faq__item">
      <summary>What's included in Blue Cap IT's managed IT services?</summary>
      <div class="bcit-faq__answer">
        <p>A flat monthly subscription covers 24/7 remote monitoring, unlimited helpdesk support for your employees, automated patch management across operating systems and applications, backup and disaster recovery, Microsoft 365 administration (user provisioning, security, licensing), network management for firewalls and Wi-Fi, and optional Virtual CIO (vCIO) services for strategic planning. Hardware refreshes, software audits, and quarterly business reviews are built in.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>How does Blue Cap IT price managed IT services?</summary>
      <div class="bcit-faq__answer">
        <p>Pricing is per-user or per-device on a flat monthly subscription — not hourly. You know your IT cost going into each month, and we make money when your systems run smoothly, not when they break. Final pricing depends on your environment size, number of servers, and which add-ons you need (vCIO, advanced backup, cybersecurity through Coro or Huntress). We'll quote your specific situation after a free assessment.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>How quickly does Blue Cap IT respond to support tickets?</summary>
      <div class="bcit-faq__answer">
        <p>Within minutes — for both critical issues (systems down, email out, suspected ransomware) and routine requests (password resets, software questions, hardware issues). Our 24/7 monitoring often catches problems before your team even notices, so we can fix things before they hit your ticket queue.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Can Blue Cap IT support remote employees and hybrid teams?</summary>
      <div class="bcit-faq__answer">
        <p>Yes. Our remote monitoring agents and helpdesk work the same whether your team is in the office, at home, or split. We secure remote endpoints, configure VPN and Zero Trust access, manage Microsoft 365 and cloud apps, and provide the same fast support regardless of where your employees sit. Most of our clients today run hybrid or fully remote operations.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Is cybersecurity included in managed IT, or is it a separate service?</summary>
      <div class="bcit-faq__answer">
        <p>Baseline cybersecurity — patch management, secure backups, Microsoft 365 security configuration, antivirus, and identity hygiene — is part of managed IT. For deeper protection like Managed Detection and Response (MDR), 24/7 SOC monitoring, endpoint behavioral analysis, email threat protection, and security awareness training, we add Coro or Huntress on top. Most clients combine both. Call (410) 858-4031 to talk through what level of protection you need.</p>
      </div>
    </details>

    <div class="bcit-faq__cta">
      <p><strong>Still have questions?</strong> Call <a href="tel:4108584031">(410) 858-4031</a> or <a href="/contact">request a free assessment</a> — we'll map your current IT environment and show you exactly what managed IT would look like for your business.</p>
    </div>
  </section>

  <!-- CTA -->
  <div class="cta-band">
    <div class="section-label">Let's Talk</div>
    <h2>Ready for Proactive<br/><span class="grad">IT Management?</span></h2>
    <p>Contact Blue Cap IT for a free quote. We'll assess your current IT environment and show you how managed services can reduce costs, improve uptime, and give you peace of mind.</p>
    <div class="btn-group">
      <a href="contact.html" class="btn-primary">Get a Free Quote</a>
      <a href="tel:4108584031" class="btn-ghost"><Icon name="lucide:phone" /> (410) 858-4031</a>
      <a href="mailto:info@bluecapit.com" class="btn-ghost"><Icon name="lucide:mail" /> info@bluecapit.com</a>
    </div>
  </div>
</MainLayout>
