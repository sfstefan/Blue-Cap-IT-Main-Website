---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What's included in Verkada Workplace beyond a basic visitor sign-in?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Workplace is a complete front-of-house platform, not just a sign-in iPad. It covers digital visitor check-in with NDA signing and automatic host notifications, on-demand visitor badge printing with photo and expiration, mailroom and package management with full chain-of-custody tracking, guest pre-registration with QR code access, background check and watchlist screening, and native integration with Verkada access control so visitors get temporary credentials that expire automatically at checkout. Everything is managed from the same Verkada Command dashboard as your cameras and doors."
      }
    },
    {
      "@type": "Question",
      "name": "How does the mailroom and package tracking feature work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Packages get scanned at the receiving point — a quick barcode scan logs the carrier, sender, and recipient. The recipient gets an automatic notification (email, SMS, or Slack) that something has arrived. When they come to pick up, a second scan confirms handoff and timestamps it. You end up with a full chain-of-custody record for every package — useful when something goes missing or arrives damaged and you need to prove when it changed hands. For high-volume mailrooms, this typically eliminates several hours of weekly admin work and dramatically reduces lost or misdelivered packages."
      }
    },
    {
      "@type": "Question",
      "name": "Can guests pre-register before arriving so they skip the kiosk line?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Employees pre-register expected visitors from their desktop or phone — name, email, arrival time, host, any required documents. The system emails the guest a QR code before their visit. On arrival, they scan the code on the kiosk and check in instantly without retyping anything. This works especially well for executive meetings, scheduled client visits, contractors, and event check-ins where you don't want guests waiting in a lobby queue. Calendar integration can auto-create pre-registrations from meeting invites."
      }
    },
    {
      "@type": "Question",
      "name": "Does Workplace include background checks and watchlist screening?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Verkada Workplace integrates with background check services to screen visitors against industry watchlists and run on-demand background checks where required (typical use cases: contractors entering secure facilities, school visitors, healthcare environments, government buildings). Flagged individuals trigger alerts to security staff before access is granted. The visitor's identity can also be verified by scanning their driver's license at the kiosk. The screening level is configurable per site and per visitor type."
      }
    },
    {
      "@type": "Question",
      "name": "Can Workplace replace a full-time receptionist?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For many businesses, yes — the kiosk handles check-in, host notifications, badge printing, pre-registration, and basic visitor questions without staff intervention. For others, Workplace doesn't replace the receptionist but frees them up to focus on the parts of the job that actually need a human (greeting key clients, answering complex questions, handling deliveries). Both patterns work. We help you think through which approach fits your building's traffic, security requirements, and culture during the free assessment."
      }
    }
  ]
};
---
<MainLayout title="Verkada Workplace | Blue Cap IT — Mid-Atlantic &amp; Carolinas" description="Verkada Workplace — visitor management, mailroom tracking, badge printing &amp; pre-registration. Blue Cap IT serves MD, DC, DE, NJ, PA, VA, NC, SC." schema={faqSchema}>
  <div class="inner-hero">
    <div class="section-inner">
      <div class="crumbs"><a href="index.html">Home</a> <span>/</span> <a href="verkada.html">Verkada Solutions</a> <span>/</span> Workplace</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center;">
        <div>
          <div class="section-label">Verkada Solution</div>
          <h1>Verkada <span class="grad">Workplace</span></h1>
          <p class="section-sub">A complete visitor management and workplace platform — digital check-in, mailroom tracking, badge printing, and seamless access control integration, all managed through Verkada Command.</p>
          <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap;">
            <a href="contact.html" class="btn-primary">Get a Free Quote</a>
            <a href="tel:4108584031" class="btn-ghost btn-sm"><Icon name="lucide:phone" /> (410) 858-4031</a>
          </div>
        </div>
        <img src="/workplace-hero.png" alt="Verkada Workplace visitor management" style="width:100%;border-radius:1rem;" />
      </div>
    </div>
  </div>

  <section>
    <div class="section-inner">
      <div style="text-align:center;max-width:600px;margin:0 auto 4rem;">
        <div class="section-label">Why Verkada Workplace</div>
        <h2>Smarter Visitor &amp; Workplace<br/><span class="grad">Management</span></h2>
        <p class="section-sub" style="text-align:center;margin:0.8rem auto 0;">Verkada Workplace replaces paper sign-in sheets and disconnected tools with a single cloud-managed platform for visitors, deliveries, and employee credentials.</p>
      </div>
      <div class="feature-list">
        <div class="feature-row">
          <div class="feature-visual"><div class="feature-visual-bg"></div><img src="/verkada/workplace/guest-checkin.jpg" alt="Verkada Workplace guest check-in mockup" style="max-width:380px;width:100%;border-radius:8px;filter:drop-shadow(0 16px 48px rgba(0,0,0,0.2));" /></div>
          <div class="feature-content">
            <h3>Digital Visitor Check-In</h3>
            <p>Replace clipboards with a professional iPad kiosk experience. Visitors check in digitally, sign NDAs, print badges, and automatically notify their host — all in under a minute.</p>
            <ul class="feature-bullets">
              <li>iPad-based kiosk for lobby check-in</li>
              <li>Custom NDA and legal document signing</li>
              <li>Automatic badge printing on arrival</li>
              <li>Instant host notifications via email, SMS, or Slack</li>
              <li>Branded check-in experience with your company logo</li>
            </ul>
          </div>
        </div>
        <div class="feature-row rev">
          <div class="feature-visual"><div class="feature-visual-bg"></div><img src="/verkada/workplace/mailroom.jpg" alt="Verkada Workplace mailroom management on laptop and mobile" style="max-width:380px;width:100%;border-radius:8px;filter:drop-shadow(0 16px 48px rgba(0,0,0,0.2));" /></div>
          <div class="feature-content">
            <h3>Mailroom &amp; Package Management</h3>
            <p>Scan, log, and track every package that enters your building. Recipients are automatically notified, and you have a complete chain-of-custody record for every delivery.</p>
            <ul class="feature-bullets">
              <li>Barcode scanning for instant package logging</li>
              <li>Automatic recipient notification</li>
              <li>Full delivery chain-of-custody tracking</li>
              <li>Pickup confirmation and audit trail</li>
              <li>Reduce lost and misdelivered packages</li>
            </ul>
          </div>
        </div>
        <div class="feature-row">
          <div class="feature-visual"><div class="feature-visual-bg"></div><img src="/verkada/workplace/dl-scan.jpg" alt="Verkada Workplace driver's license scanning for guest registration" style="max-width:380px;width:100%;border-radius:8px;filter:drop-shadow(0 16px 48px rgba(0,0,0,0.2));" /></div>
          <div class="feature-content">
            <h3>Guest Pre-Registration &amp; QR Code Access</h3>
            <p>Employees can pre-register guests ahead of time. Visitors receive a QR code via email that lets them check in instantly on arrival — no waiting in line.</p>
            <ul class="feature-bullets">
              <li>Pre-register visitors from desktop or mobile</li>
              <li>Guests receive QR code before arrival</li>
              <li>Scan-to-check-in for a frictionless experience</li>
              <li>Pre-approved visitors skip the full registration flow</li>
              <li>Calendar integration for scheduled meetings</li>
            </ul>
          </div>
        </div>
        <div class="feature-row rev">
          <div class="feature-visual"><div class="feature-visual-bg"></div><img src="/verkada/workplace/background-check.png" alt="Verkada Workplace background check screen" style="max-width:380px;width:100%;border-radius:8px;filter:drop-shadow(0 16px 48px rgba(0,0,0,0.2));" /></div>
          <div class="feature-content">
            <h3>Background Checks &amp; Access Control Integration</h3>
            <p>Screen visitors against watchlists and run background checks before granting access. Verkada Workplace integrates directly with Verkada access control for seamless door unlock upon check-in.</p>
            <ul class="feature-bullets">
              <li>Background check integration for visitor screening</li>
              <li>Watchlist alerts for flagged individuals</li>
              <li>Automatic temporary access credentials on check-in</li>
              <li>Access revoked automatically on checkout</li>
              <li>All managed through Verkada Command</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="specs-section">
    <div class="section-inner">
      <div class="section-label">Workplace Features</div>
      <h2>Verkada Workplace <span class="grad">Capabilities</span></h2>
      <p class="section-sub">Everything you need to manage visitors, deliveries, and employee credentials in one platform.</p>
      <div class="products-grid">
        <div class="product-card">
          <div class="pcard-icon"><img src="/verkada/workplace/guest-iphone.jpg" alt="Visitor check-in on iPhone" style="width:48px;height:48px;border-radius:8px;object-fit:cover;" /></div>
          <h3>Visitor Management</h3>
          <p>Digital check-in kiosk with NDA signing, host notifications, and a complete visitor log — replacing paper sign-in sheets with a professional, secure experience.</p>
        </div>
        <div class="product-card">
          <div class="pcard-icon"><img src="/verkada/workplace/reception-ui.png" alt="Mailroom reception UI" style="width:48px;height:48px;border-radius:8px;object-fit:cover;" /></div>
          <h3>Mailroom Management</h3>
          <p>Scan and track every package from arrival to pickup. Recipients are notified automatically, and every handoff is logged for accountability.</p>
        </div>
        <div class="product-card">
          <div class="pcard-icon"><img src="/verkada/workplace/guest-printer.png" alt="Guest badge printer" style="width:48px;height:48px;border-radius:8px;object-fit:cover;" /></div>
          <h3>Badge Printing</h3>
          <p>Print visitor and employee badges on demand. Badges include photo, name, host, and expiration — making it easy to identify who belongs in your building.</p>
        </div>
        <div class="product-card">
          <div class="pcard-icon"><img src="/verkada/workplace/guest-checkin.jpg" alt="Guest check-in" style="width:48px;height:48px;border-radius:8px;object-fit:cover;" /></div>
          <h3>Guest Pre-Registration</h3>
          <p>Employees pre-register visitors ahead of time. Guests receive a QR code for instant check-in on arrival — no lines, no delays.</p>
        </div>
        <div class="product-card">
          <div class="pcard-icon"><img src="/verkada/workplace/background-check.png" alt="Background check" style="width:48px;height:48px;border-radius:8px;object-fit:cover;" /></div>
          <h3>Background Checks</h3>
          <p>Screen visitors against watchlists and run background checks before granting building access. Stay compliant and keep your people safe.</p>
        </div>
        <div class="product-card">
          <div class="pcard-icon"><Icon name="lucide:door-open" /></div>
          <h3>Access Integration</h3>
          <p>Verkada Workplace connects directly to Verkada access control. Visitors receive temporary credentials at check-in that are automatically revoked at checkout.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bcit-faq" aria-labelledby="workplace-faq-heading">
    <h2 id="workplace-faq-heading" class="bcit-faq__heading">Frequently Asked Questions</h2>
    <p class="bcit-faq__intro">Common questions about Verkada Workplace from Blue Cap IT, an official Verkada Gold Partner — digital visitor check-in, mailroom and package tracking, badge printing, guest pre-registration, and access control integration for businesses across Maryland, DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina.</p>

    <details class="bcit-faq__item">
      <summary>What's included in Verkada Workplace beyond a basic visitor sign-in?</summary>
      <div class="bcit-faq__answer">
        <p>Workplace is a complete front-of-house platform, not just a sign-in iPad. It covers digital visitor check-in with NDA signing and automatic host notifications, on-demand visitor badge printing with photo and expiration, mailroom and package management with full chain-of-custody tracking, guest pre-registration with QR code access, background check and watchlist screening, and native integration with Verkada access control so visitors get temporary credentials that expire automatically at checkout. Everything is managed from the same Verkada Command dashboard as your cameras and doors.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>How does the mailroom and package tracking feature work?</summary>
      <div class="bcit-faq__answer">
        <p>Packages get scanned at the receiving point — a quick barcode scan logs the carrier, sender, and recipient. The recipient gets an automatic notification (email, SMS, or Slack) that something has arrived. When they come to pick up, a second scan confirms handoff and timestamps it. You end up with a full chain-of-custody record for every package — useful when something goes missing or arrives damaged and you need to prove when it changed hands. For high-volume mailrooms, this typically eliminates several hours of weekly admin work and dramatically reduces lost or misdelivered packages.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Can guests pre-register before arriving so they skip the kiosk line?</summary>
      <div class="bcit-faq__answer">
        <p>Yes. Employees pre-register expected visitors from their desktop or phone — name, email, arrival time, host, any required documents. The system emails the guest a QR code before their visit. On arrival, they scan the code on the kiosk and check in instantly without retyping anything. This works especially well for executive meetings, scheduled client visits, contractors, and event check-ins where you don't want guests waiting in a lobby queue. Calendar integration can auto-create pre-registrations from meeting invites.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Does Workplace include background checks and watchlist screening?</summary>
      <div class="bcit-faq__answer">
        <p>Yes. Verkada Workplace integrates with background check services to screen visitors against industry watchlists and run on-demand background checks where required (typical use cases: contractors entering secure facilities, school visitors, healthcare environments, government buildings). Flagged individuals trigger alerts to security staff before access is granted. The visitor's identity can also be verified by scanning their driver's license at the kiosk. The screening level is configurable per site and per visitor type.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Can Workplace replace a full-time receptionist?</summary>
      <div class="bcit-faq__answer">
        <p>For many businesses, yes — the kiosk handles check-in, host notifications, badge printing, pre-registration, and basic visitor questions without staff intervention. For others, Workplace doesn't replace the receptionist but frees them up to focus on the parts of the job that actually need a human (greeting key clients, answering complex questions, handling deliveries). Both patterns work. We help you think through which approach fits your building's traffic, security requirements, and culture during the free assessment.</p>
      </div>
    </details>

    <div class="bcit-faq__cta">
      <p><strong>Still have questions?</strong> Call <a href="tel:4108584031">(410) 858-4031</a> or <a href="/contact">request a free Workplace assessment</a> — we'll walk your lobby and mailroom, recommend kiosk and printer placement, and quote your full deployment with itemized pricing.</p>
    </div>
  </section>

  <div class="cta-band">
    <div class="section-label">Upgrade Your Front Desk</div>
    <h2>Modern Visitor Management by<br/><span class="grad">Blue Cap IT</span></h2>
    <p>We deploy and configure Verkada Workplace for your building — from kiosk setup to access control integration. Contact us for a free quote.</p>
    <div class="btn-group">
      <a href="contact.html" class="btn-primary">Get a Free Quote</a>
      <a href="tel:4108584031" class="btn-ghost"><Icon name="lucide:phone" /> (410) 858-4031</a>
      <a href="mailto:info@bluecapit.com" class="btn-ghost"><Icon name="lucide:mail" /> info@bluecapit.com</a>
    </div>
  </div>
</MainLayout>
