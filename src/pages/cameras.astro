---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Which Verkada camera model should I choose for my facility?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The right model depends on the environment and what you're trying to capture. Indoor Dome (D-Series, 4–8MP) covers offices, retail floors, and lobbies. Outdoor Dome (CD-Series, weatherproof and vandal-resistant up to 4K) handles entrances, parking lots, and exterior walls. PTZ cameras with 32x optical zoom and auto-tracking cover large open areas like warehouses or campuses. LPR (license plate recognition) cameras read plates at speed for parking lots and gates. Low-light cameras deliver color imaging in near-darkness for lobbies and hallways. Fisheye 360° cameras replace multiple fixed cameras in open floor plans. We walk your site during a free assessment and spec the right combination — most facilities use a mix."
      }
    },
    {
      "@type": "Question",
      "name": "What AI analytics do Verkada cameras include?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every Verkada camera processes AI locally — no separate servers or subscriptions. Standard analytics include person and vehicle detection, motion search (find clips of specific events in seconds), occupancy and crowd monitoring, and configurable alerts. License plate recognition is built into LPR-specific models, with a searchable plate database and watchlist triggers. Higher-tier models add facial recognition with watchlists. All analytics run on-camera, so they keep working even if internet connectivity drops."
      }
    },
    {
      "@type": "Question",
      "name": "How much footage do Verkada cameras store, and what happens if the internet goes down?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Verkada cameras have built-in solid-state storage that holds 30 to 365 days of continuous footage depending on the model and license tier. Recording happens locally on the camera, with optional encrypted cloud backup for redundancy. If your internet goes down, the cameras keep recording — once connectivity returns, recent activity syncs to the cloud automatically. You never lose footage to a network outage, and you never need an NVR to act as a single point of failure."
      }
    },
    {
      "@type": "Question",
      "name": "Can I view footage from my phone, or only from a computer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Both. Verkada Command works in any modern web browser and has dedicated iOS and Android apps. Live views, recorded playback, multi-camera grids, motion search, and alert review are all available on mobile. The same granular user permissions apply — so a manager can see all sites while a department head only sees their floor — and every action is logged for audit. No VPN, no port forwarding, no separate viewer software."
      }
    },
    {
      "@type": "Question",
      "name": "What's covered under Verkada's hardware warranty?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every Verkada camera ships with a 10-year hardware warranty — one of the longest in the industry. If a camera fails within that window, Verkada replaces it. Firmware updates, security patches, and AI model improvements are pushed automatically by Verkada throughout the life of your subscription, so cameras keep getting smarter without you doing anything. Blue Cap IT handles RMA paperwork, on-site swap-outs, and reconfiguration if a replacement is ever needed — you don't deal with vendor logistics."
      }
    }
  ]
};
---
<MainLayout title="Verkada Cameras | Blue Cap IT — Mid-Atlantic &amp; Carolinas" description="Verkada AI-powered security cameras from Blue Cap IT — cloud-managed, no NVR required. Verkada Gold Partner serving MD, DC, DE, NJ, PA, VA, NC, SC." schema={faqSchema}>
  <div class="inner-hero">
    <div class="section-inner">
      <div class="crumbs"><a href="index.html">Home</a> <span>/</span> <a href="verkada.html">Verkada Solutions</a> <span>/</span> Video Security Cameras</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center;">
        <div>
          <div class="section-label">Verkada Solution</div>
          <h1>Video Security <span class="grad">Cameras</span></h1>
          <p class="section-sub">AI-powered, cloud-managed cameras with built-in storage and zero on-site servers. See everything, from anywhere, on any device.</p>
          <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap;">
            <a href="contact.html" class="btn-primary">Get a Free Quote</a>
            <a href="tel:4108584031" class="btn-ghost btn-sm"><Icon name="lucide:phone" /> (410) 858-4031</a>
          </div>
        </div>
        <img src="/Cameras_Family_Portrait_Pillars.webp" alt="Verkada Security Cameras" class="feature-img" width="1600" height="900" fetchpriority="high" />
      </div>
    </div>
  </div>

  <section>
    <div class="section-inner">
      <div style="text-align:center;max-width:600px;margin:0 auto 4rem;">
        <div class="section-label">Why Verkada Cameras</div>
        <h2>Smarter Cameras.<br/><span class="grad">Zero Complexity.</span></h2>
        <p class="section-sub" style="text-align:center;margin:0.8rem auto 0;">Verkada cameras combine on-board AI processing with cloud management to deliver enterprise-grade surveillance without the enterprise-grade headaches.</p>
      </div>
      <div class="feature-list">
        <div class="feature-row">
          <div class="feature-visual"><div class="feature-visual-bg"></div><div class="big-icon"><Icon name="lucide:brain" /></div></div>
          <div class="feature-content">
            <h3>On-Board AI Analytics</h3>
            <p>Each Verkada camera processes AI analytics locally — no separate servers required. Get real-time intelligence built into every device.</p>
            <ul class="feature-bullets">
              <li>Person &amp; vehicle detection with instant alerts</li>
              <li>License plate recognition (LPR) on compatible models</li>
              <li>Facial recognition &amp; watchlist alerts</li>
              <li>Crowd detection and occupancy monitoring</li>
              <li>Motion search — find footage in seconds</li>
            </ul>
          </div>
        </div>
        <div class="feature-row rev">
          <div class="feature-visual"><div class="feature-visual-bg"></div><div class="big-icon"><Icon name="lucide:cloud" /></div></div>
          <div class="feature-content">
            <h3>True Cloud Management</h3>
            <p>Every camera is managed through Verkada Command — a browser-based dashboard accessible from anywhere. No VPN, no NVR, no on-premise server.</p>
            <ul class="feature-bullets">
              <li>Live view and playback from any browser or mobile app</li>
              <li>Automatic firmware updates pushed by Verkada</li>
              <li>Multi-site management from one unified dashboard</li>
              <li>Granular user permissions and audit logs</li>
              <li>10-year hardware warranty on all cameras</li>
            </ul>
          </div>
        </div>
        <div class="feature-row">
          <div class="feature-visual"><div class="feature-visual-bg"></div><div class="big-icon"><Icon name="lucide:database" /></div></div>
          <div class="feature-content">
            <h3>Hybrid On-Board Storage</h3>
            <p>Video footage is stored directly on the camera's built-in solid-state drive — up to 365 days of local storage — and backed up to the cloud simultaneously.</p>
            <ul class="feature-bullets">
              <li>No NVR or DVR required — ever</li>
              <li>Up to 365 days of on-board video retention</li>
              <li>Automatic cloud backup included</li>
              <li>Footage survives network outages</li>
              <li>Tamper-evident encrypted storage</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="specs-section">
    <div class="section-inner">
      <div class="section-label">Camera Lines</div>
      <h2>Verkada Camera <span class="grad">Models</span></h2>
      <p class="section-sub">Blue Cap IT carries the full Verkada camera lineup. Contact us for pricing and availability.</p>
      <div class="specs-grid">
        <div class="spec-card"><img src="/verkada/cameras/mini-dome.webp" alt="Indoor Mini Dome Camera" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="1061" loading="lazy" decoding="async" /><h4>Indoor Dome (D-Series)</h4><ul><li>4MP, 5MP, 8MP options</li><li>Ceiling or wall mount</li><li>Wide dynamic range</li><li>Built-in microphone</li><li>Ideal for offices &amp; retail</li></ul></div>
        <div class="spec-card"><img src="/verkada/cameras/outdoor-dome.webp" alt="Outdoor Dome Camera" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="901" loading="lazy" decoding="async" /><h4>Outdoor Dome (CD-Series)</h4><ul><li>IP66 weatherproof rating</li><li>IK10 vandal resistant</li><li>4K ultra-HD available</li><li>Built-in IR night vision</li><li>Ideal for entrances &amp; parking</li></ul></div>
        <div class="spec-card"><img src="/verkada/cameras/ptz-camera.webp" alt="PTZ Camera" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="1000" loading="lazy" decoding="async" /><h4>PTZ Cameras</h4><ul><li>Pan / Tilt / Zoom control</li><li>32x optical zoom</li><li>Auto-tracking</li><li>Wide area coverage</li><li>Ideal for large open areas</li></ul></div>
        <div class="spec-card"><h4>🚗 License Plate (LPR)</h4><ul><li>Dedicated LPR processing</li><li>Reads plates at speed</li><li>Searchable plate database</li><li>Watchlist &amp; alert triggers</li><li>Ideal for parking &amp; gates</li></ul></div>
        <div class="spec-card"><img src="/verkada/cameras/bullet-camera.webp" alt="Bullet Camera for Low Light" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="1000" loading="lazy" decoding="async" /><h4>Low-Light Cameras</h4><ul><li>Color imaging in near-darkness</li><li>No IR glare or halo</li><li>F1.0 aperture available</li><li>Superior night performance</li><li>Ideal for lobbies &amp; hallways</li></ul></div>
        <div class="spec-card"><img src="/verkada/cameras/fisheye-camera.webp" alt="Fisheye 360° Camera" style="width:100%;border-radius:0.5rem;margin-bottom:0.75rem;" width="1600" height="1068" loading="lazy" decoding="async" /><h4>Fisheye 360°</h4><ul><li>Full 360° panoramic view</li><li>Replaces multiple cameras</li><li>Dewarped live playback</li><li>12MP sensor</li><li>Ideal for open floor plans</li></ul></div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-inner" style="text-align:center;max-width:800px;margin:0 auto;padding:4rem 1.5rem;">
      <div class="section-label">Watch</div>
      <h2>Verkada Cameras <span class="grad">in Action</span></h2>
      <p class="section-sub" style="text-align:center;margin:0.8rem auto 2rem;">See how Verkada's AI-powered cameras deliver smarter security with cloud management, built-in storage, and real-time analytics.</p>
      <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:1rem;box-shadow:0 8px 32px rgba(0,0,0,0.3);">
        <iframe src="https://www.youtube.com/embed/5oIER0pcyEk" title="Verkada Video Security Cameras" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position:absolute;top:0;left:0;width:100%;height:100%;"></iframe>
      </div>
    </div>
  </section>


  <section>
    <div class="section-inner" style="text-align:center;max-width:700px;margin:0 auto;padding:2rem 1.5rem 4rem;">
      <div class="section-label">Resources</div>
      <h2>Verkada Camera <span class="grad">Downloads</span></h2>
      <div style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;margin-top:2rem;">
        <a href="/verkada/docs/ai-powered-search-alerts-overview.pdf" target="_blank" class="btn-ghost" style="display:inline-flex;align-items:center;gap:0.5rem;"><Icon name="lucide:file-text" /> AI-Powered Search & Alerts Overview</a>
        <a href="/verkada/docs/traditional-vs-ai-powered-investigations.pdf" target="_blank" class="btn-ghost" style="display:inline-flex;align-items:center;gap:0.5rem;"><Icon name="lucide:file-text" /> Traditional vs AI-Powered Investigations</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bcit-faq" aria-labelledby="cameras-faq-heading">
    <h2 id="cameras-faq-heading" class="bcit-faq__heading">Frequently Asked Questions</h2>
    <p class="bcit-faq__intro">Common questions about Verkada cloud-managed security cameras from Blue Cap IT, an official Verkada Gold Partner — for businesses across Maryland, DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina.</p>

    <details class="bcit-faq__item">
      <summary>Which Verkada camera model should I choose for my facility?</summary>
      <div class="bcit-faq__answer">
        <p>The right model depends on the environment and what you're trying to capture. Indoor Dome (D-Series, 4–8MP) covers offices, retail floors, and lobbies. Outdoor Dome (CD-Series, weatherproof and vandal-resistant up to 4K) handles entrances, parking lots, and exterior walls. PTZ cameras with 32x optical zoom and auto-tracking cover large open areas like warehouses or campuses. LPR (license plate recognition) cameras read plates at speed for parking lots and gates. Low-light cameras deliver color imaging in near-darkness for lobbies and hallways. Fisheye 360° cameras replace multiple fixed cameras in open floor plans. We walk your site during a free assessment and spec the right combination — most facilities use a mix.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>What AI analytics do Verkada cameras include?</summary>
      <div class="bcit-faq__answer">
        <p>Every Verkada camera processes AI locally — no separate servers or subscriptions. Standard analytics include person and vehicle detection, motion search (find clips of specific events in seconds), occupancy and crowd monitoring, and configurable alerts. License plate recognition is built into LPR-specific models, with a searchable plate database and watchlist triggers. Higher-tier models add facial recognition with watchlists. All analytics run on-camera, so they keep working even if internet connectivity drops.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>How much footage do Verkada cameras store, and what happens if the internet goes down?</summary>
      <div class="bcit-faq__answer">
        <p>Verkada cameras have built-in solid-state storage that holds 30 to 365 days of continuous footage depending on the model and license tier. Recording happens locally on the camera, with optional encrypted cloud backup for redundancy. If your internet goes down, the cameras keep recording — once connectivity returns, recent activity syncs to the cloud automatically. You never lose footage to a network outage, and you never need an NVR to act as a single point of failure.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Can I view footage from my phone, or only from a computer?</summary>
      <div class="bcit-faq__answer">
        <p>Both. Verkada Command works in any modern web browser and has dedicated iOS and Android apps. Live views, recorded playback, multi-camera grids, motion search, and alert review are all available on mobile. The same granular user permissions apply — so a manager can see all sites while a department head only sees their floor — and every action is logged for audit. No VPN, no port forwarding, no separate viewer software.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>What's covered under Verkada's hardware warranty?</summary>
      <div class="bcit-faq__answer">
        <p>Every Verkada camera ships with a 10-year hardware warranty — one of the longest in the industry. If a camera fails within that window, Verkada replaces it. Firmware updates, security patches, and AI model improvements are pushed automatically by Verkada throughout the life of your subscription, so cameras keep getting smarter without you doing anything. Blue Cap IT handles RMA paperwork, on-site swap-outs, and reconfiguration if a replacement is ever needed — you don't deal with vendor logistics.</p>
      </div>
    </details>

    <div class="bcit-faq__cta">
      <p><strong>Still have questions?</strong> Call <a href="tel:4108584031">(410) 858-4031</a> or <a href="/contact">request a free site assessment</a> — we'll walk your facility, recommend the right camera models for each area, and quote your full project with itemized pricing.</p>
    </div>
  </section>

  <div class="cta-band">
    <div class="section-label">Ready to See a Demo?</div>
    <h2>Let Blue Cap IT Design Your<br/><span class="grad">Camera System</span></h2>
    <p>We'll assess your site, recommend the right Verkada camera models, and provide a detailed quote — completely free.</p>
    <div class="btn-group">
      <a href="contact.html" class="btn-primary">Get a Free Quote</a>
      <a href="tel:4108584031" class="btn-ghost"><Icon name="lucide:phone" /> (410) 858-4031</a>
      <a href="mailto:info@bluecapit.com" class="btn-ghost"><Icon name="lucide:mail" /> info@bluecapit.com</a>
    </div>
  </div>
</MainLayout>
