---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the Verkada Command Connector, and what problem does it solve?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Command Connector is a compact on-premise appliance that brings non-Verkada cameras into the Verkada Command cloud dashboard. Most organizations don't want to rip out hundreds of existing cameras to standardize on Verkada — and they don't have to. Command Connector connects to your existing ONVIF-compatible cameras, streams them into Command alongside any native Verkada devices, and gives you one unified dashboard for live view, search, alerts, and AI analytics. It's the practical migration path for facilities with significant existing camera investment."
      }
    },
    {
      "@type": "Question",
      "name": "Which existing cameras work with Command Connector?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most ONVIF-compatible IP cameras from any manufacturer — including Axis, Hikvision, Dahua, Hanwha, Bosch, Pelco, and many others. ONVIF is the industry standard most modern IP cameras support, so if your cameras were installed in roughly the last decade, there's a strong chance they'll work. Older analog cameras and proprietary systems generally won't, but we can audit your existing fleet during a free assessment and tell you exactly which cameras carry over and which would need replacement."
      }
    },
    {
      "@type": "Question",
      "name": "Do third-party cameras get the same AI features as native Verkada cameras through Command Connector?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most of them, yes. Once a camera is connected, Verkada's AI engine processes the video feed in the same way it processes native Verkada cameras — person and vehicle detection, motion search, smart filters, motion-based alerts, and object tracking all work on third-party feeds. Some camera-specific hardware features (like a Verkada camera's on-board LPR or facial recognition) require native hardware, but the core AI and search capabilities apply across both. The dashboard experience is identical regardless of camera brand."
      }
    },
    {
      "@type": "Question",
      "name": "Can Command Connector replace my existing NVR or DVR?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In most cases, yes. Command Connector includes on-board storage for third-party camera recordings and connects to Verkada's cloud for remote access, so a standalone NVR or DVR becomes redundant. You retire the old recording infrastructure, the cameras stream into the Connector, footage is stored locally and synced to Command for remote viewing. The single appliance becomes your storage, your viewer, your AI engine, and your remote-access gateway — no separate boxes to maintain."
      }
    },
    {
      "@type": "Question",
      "name": "Is Command Connector a temporary bridge, or a permanent solution?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Either, depending on your strategy. Many clients use it as a permanent solution — they have good cameras that don't need replacing, and they just want modern cloud management and AI on top. Others use it as a phased migration: connect all existing cameras to Command Connector now, then replace individual cameras with native Verkada units over time as they age out, without disrupting operations or losing footage continuity. Both paths are valid — and both end up with everything managed from the same dashboard."
      }
    }
  ]
};
---
<MainLayout title="Verkada Command Connector | Blue Cap IT — Mid-Atlantic &amp; Carolinas" description="Command Connector brings third-party &amp; legacy cameras into Verkada Command. Blue Cap IT — Verkada Gold Partner serving MD, DC, DE, NJ, PA, VA, NC, SC." schema={faqSchema}>
  <div class="inner-hero">
    <div class="section-inner">
      <div class="crumbs"><a href="index.html">Home</a> <span>/</span> <a href="verkada.html">Verkada Solutions</a> <span>/</span> Command Connector</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center;">
        <div>
          <div class="section-label">Verkada Solution</div>
          <h1>Verkada <span class="grad">Command Connector</span></h1>
          <p class="section-sub">Bring your existing cameras into the Verkada cloud. Command Connector is Verkada's on-premise appliance that integrates third-party, ONVIF-compatible cameras into the Verkada Command platform — so you can keep your current investment while gaining modern cloud management.</p>
          <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap;">
            <a href="contact.html" class="btn-primary">Get a Free Quote</a>
            <a href="tel:4108584031" class="btn-ghost btn-sm"><Icon name="lucide:phone" /> (410) 858-4031</a>
          </div>
        </div>
        <img src="/command-connector-hero.png" alt="Verkada Command Connector appliance" style="width:100%;border-radius:1rem;" />
      </div>
    </div>
  </div>

  <section>
    <div class="section-inner">
      <div class="feature-list">
        <div class="feature-row">
          <div class="feature-visual"><div class="feature-visual-bg"></div><div class="big-icon"><Icon name="lucide:link" /></div></div>
          <div class="feature-content">
            <h3>Integrate Third-Party Cameras into Verkada Command</h3>
            <p>Command Connector is Verkada's on-premise appliance that bridges the gap between legacy camera systems and the Verkada cloud platform. Connect non-Verkada cameras and manage them alongside native Verkada devices in a single dashboard.</p>
            <ul class="feature-bullets">
              <li>Supports ONVIF-compatible cameras from any manufacturer</li>
              <li>View third-party feeds directly in Verkada Command</li>
              <li>Unified management for both Verkada and non-Verkada cameras</li>
              <li>No need to rip and replace your existing camera infrastructure</li>
              <li>Gradual migration path to a full Verkada deployment</li>
            </ul>
          </div>
        </div>
        <div class="feature-row rev">
          <div class="feature-visual"><div class="feature-visual-bg"></div><div class="big-icon"><Icon name="lucide:brain" /></div></div>
          <div class="feature-content">
            <h3>AI Analytics on Any Camera</h3>
            <p>Unlock Verkada's powerful AI-driven analytics on your existing camera feeds. Command Connector applies the same intelligent video processing used on native Verkada cameras to your third-party devices.</p>
            <ul class="feature-bullets">
              <li>Person and vehicle detection on third-party camera feeds</li>
              <li>Searchable video history with smart filters</li>
              <li>Motion-based alerts and notifications</li>
              <li>Object tracking across connected cameras</li>
              <li>Same AI capabilities as native Verkada cameras</li>
            </ul>
          </div>
        </div>
        <div class="feature-row">
          <div class="feature-visual"><div class="feature-visual-bg"></div><div class="big-icon"><Icon name="lucide:database" /></div></div>
          <div class="feature-content">
            <h3>Local Storage &amp; Cloud Connectivity</h3>
            <p>Command Connector provides on-site storage for your third-party camera footage while maintaining cloud connectivity to Verkada Command. Video is stored locally and accessible remotely — no separate NVR required.</p>
            <ul class="feature-bullets">
              <li>On-board storage for third-party camera recordings</li>
              <li>Cloud-managed with remote access from anywhere</li>
              <li>Eliminates the need for standalone NVRs or DVRs</li>
              <li>Automatic health monitoring and status alerts</li>
              <li>End-to-end encryption for all video data</li>
            </ul>
          </div>
        </div>
        <div class="feature-row rev">
          <div class="feature-visual"><div class="feature-visual-bg"></div><div class="big-icon"><Icon name="lucide:building-2" /></div></div>
          <div class="feature-content">
            <h3>Protect Your Existing Camera Investment</h3>
            <p>Organizations with hundreds or thousands of legacy cameras don't need to replace everything overnight. Command Connector lets you bring those cameras into Verkada Command today and transition to native Verkada hardware on your own timeline.</p>
            <ul class="feature-bullets">
              <li>Keep existing cameras from Axis, Hikvision, Dahua, Hanwha, and more</li>
              <li>Reduce upfront costs by leveraging current infrastructure</li>
              <li>Centralized management across all sites and camera types</li>
              <li>Phased migration strategy with no disruption to operations</li>
              <li>Full Verkada Command features for every connected camera</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-inner" style="text-align:center;max-width:800px;">
      <div class="section-label">Hardware</div>
      <h2>Command Connector <span class="grad">Appliance</span></h2>
      <p class="section-sub">The Command Connector is a compact, rack-mountable appliance designed for easy deployment. It connects to your network, discovers ONVIF-compatible cameras, and streams them into Verkada Command with minimal configuration. Available in multiple models to match your camera count and storage requirements.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bcit-faq" aria-labelledby="command-connector-faq-heading">
    <h2 id="command-connector-faq-heading" class="bcit-faq__heading">Frequently Asked Questions</h2>
    <p class="bcit-faq__intro">Common questions about Verkada Command Connector from Blue Cap IT, an official Verkada Gold Partner — the on-premise appliance that brings existing ONVIF cameras into the Verkada Command cloud platform for businesses across Maryland, DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina.</p>

    <details class="bcit-faq__item">
      <summary>What is the Verkada Command Connector, and what problem does it solve?</summary>
      <div class="bcit-faq__answer">
        <p>Command Connector is a compact on-premise appliance that brings non-Verkada cameras into the Verkada Command cloud dashboard. Most organizations don't want to rip out hundreds of existing cameras to standardize on Verkada — and they don't have to. Command Connector connects to your existing ONVIF-compatible cameras, streams them into Command alongside any native Verkada devices, and gives you one unified dashboard for live view, search, alerts, and AI analytics. It's the practical migration path for facilities with significant existing camera investment.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Which existing cameras work with Command Connector?</summary>
      <div class="bcit-faq__answer">
        <p>Most ONVIF-compatible IP cameras from any manufacturer — including Axis, Hikvision, Dahua, Hanwha, Bosch, Pelco, and many others. ONVIF is the industry standard most modern IP cameras support, so if your cameras were installed in roughly the last decade, there's a strong chance they'll work. Older analog cameras and proprietary systems generally won't, but we can audit your existing fleet during a free assessment and tell you exactly which cameras carry over and which would need replacement.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Do third-party cameras get the same AI features as native Verkada cameras through Command Connector?</summary>
      <div class="bcit-faq__answer">
        <p>Most of them, yes. Once a camera is connected, Verkada's AI engine processes the video feed in the same way it processes native Verkada cameras — person and vehicle detection, motion search, smart filters, motion-based alerts, and object tracking all work on third-party feeds. Some camera-specific hardware features (like a Verkada camera's on-board LPR or facial recognition) require native hardware, but the core AI and search capabilities apply across both. The dashboard experience is identical regardless of camera brand.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Can Command Connector replace my existing NVR or DVR?</summary>
      <div class="bcit-faq__answer">
        <p>In most cases, yes. Command Connector includes on-board storage for third-party camera recordings and connects to Verkada's cloud for remote access, so a standalone NVR or DVR becomes redundant. You retire the old recording infrastructure, the cameras stream into the Connector, footage is stored locally and synced to Command for remote viewing. The single appliance becomes your storage, your viewer, your AI engine, and your remote-access gateway — no separate boxes to maintain.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Is Command Connector a temporary bridge, or a permanent solution?</summary>
      <div class="bcit-faq__answer">
        <p>Either, depending on your strategy. Many clients use it as a permanent solution — they have good cameras that don't need replacing, and they just want modern cloud management and AI on top. Others use it as a phased migration: connect all existing cameras to Command Connector now, then replace individual cameras with native Verkada units over time as they age out, without disrupting operations or losing footage continuity. Both paths are valid — and both end up with everything managed from the same dashboard.</p>
      </div>
    </details>

    <div class="bcit-faq__cta">
      <p><strong>Still have questions?</strong> Call <a href="tel:4108584031">(410) 858-4031</a> or <a href="/contact">request a free camera assessment</a> — we'll audit your existing camera fleet, identify what carries over to Command Connector, and quote a phased migration plan with itemized pricing.</p>
    </div>
  </section>

  <div class="cta-band">
    <div class="section-label">Ready to Unify Your Camera System?</div>
    <h2>Bring Your Cameras into<br/><span class="grad">Verkada Command</span></h2>
    <p>Blue Cap IT will assess your current camera infrastructure and show you how Command Connector can bring everything into one platform. Get a free quote today.</p>
    <div class="btn-group">
      <a href="contact.html" class="btn-primary">Get a Free Quote</a>
      <a href="tel:4108584031" class="btn-ghost"><Icon name="lucide:phone" /> (410) 858-4031</a>
      <a href="mailto:info@bluecapit.com" class="btn-ghost"><Icon name="lucide:mail" /> info@bluecapit.com</a>
    </div>
  </div>
</MainLayout>
