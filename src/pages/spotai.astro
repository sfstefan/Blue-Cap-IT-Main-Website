---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is spot.ai, and how is it different from traditional video surveillance?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "spot.ai is an AI-powered video intelligence platform that turns existing security cameras into active business tools. Traditional video surveillance just records — you only watch the footage after something has already happened. spot.ai watches it in real time using deep-learning models, automatically detecting events (intrusions, PPE violations, vehicle idle time, queue length, customer flow), surfacing insights you'd never find manually, and alerting your team when something matters. It's the difference between a video archive and an AI teammate."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to replace my existing cameras to use spot.ai?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. spot.ai is fully camera-agnostic and works with any ONVIF-compliant IP camera you already own. The platform's intelligence lives in the Intelligent Video Recorder (IVR) — a purpose-built appliance that auto-discovers your cameras, runs deep-learning models at the edge, and adds AI analytics to footage from cameras you've already paid for. If you do need new cameras, spot.ai includes premium IP cameras at no additional cost."
      }
    },
    {
      "@type": "Question",
      "name": "How is spot.ai different from Verkada, and how should I choose between them?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Verkada is a closed ecosystem — you buy Verkada cameras and manage them through Verkada Command. It's the right choice if you're starting fresh, want a single unified physical-security platform (cameras, access control, alarms, sensors, intercoms), and value tight hardware-software integration. spot.ai is camera-agnostic and AI-first — you keep your existing cameras and bolt on industry-leading AI analytics, alerts, and operational intelligence. The right choice depends on whether you're rebuilding your physical security from scratch (lean Verkada) or extending what you already have with smarter analytics (lean spot.ai). Call (410) 858-4031 and we'll help you pick."
      }
    },
    {
      "@type": "Question",
      "name": "What can spot.ai's AI actually detect, and what does it do with the footage?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "spot.ai's deep-learning models classify people, vehicles, forklifts, and objects, then apply rules for counting, anomaly detection, and trend analysis. Real-world detections include: PPE compliance (hard hats, vests, masks), intrusion in restricted areas, slip-and-fall events, license plate recognition, queue length and customer flow, employee productivity patterns, forklift safety violations, after-hours activity, and many more. When a detection matches your rules, spot.ai sends a real-time alert with the relevant video clip attached — so your team responds with context, not guesses."
      }
    },
    {
      "@type": "Question",
      "name": "Where is footage stored, and what about data privacy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "spot.ai uses a hybrid cloud architecture. Video is recorded and encrypted locally on the Intelligent Video Recorder (typically 30 to 120 days of retention depending on configuration), with cloud access available for remote viewing, search, and incident review. Footage stays under your control — only metadata and event tags flow to the cloud unless you explicitly choose to upload clips. spot.ai's security architecture and compliance posture are designed for regulated industries, including healthcare, education, manufacturing, and retail."
      }
    }
  ]
};
---
<MainLayout ogImage="/images/spotai-hero.webp" title="spot.ai Video Intelligence | Blue Cap IT — Mid-Atlantic &amp; Carolinas" description="AI-powered video intelligence from spot.ai through Blue Cap IT — camera-agnostic platform serving MD, DC, DE, NJ, PA, VA, NC, SC." schema={faqSchema}>
  <div class="inner-hero">
