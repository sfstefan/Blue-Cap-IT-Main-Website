---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Verkada, and how is it different from traditional security camera systems?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Verkada is a cloud-managed physical security platform — cameras, access control, alarms, sensors, and intercoms — that's managed entirely through one web dashboard called Verkada Command. Unlike traditional NVR-based systems that require on-site servers, complex configuration, and clunky software, every Verkada device stores footage locally and connects directly to the cloud. You view live and recorded video from any browser or phone, anywhere in the world, with no port forwarding, no dynamic DNS, and no IT headaches."
      }
    },
    {
      "@type": "Question",
      "name": "What does it mean that Blue Cap IT is a Verkada Gold Partner?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Verkada Gold is one of the highest partner tiers — earned through certified training, demonstrated installation expertise, and ongoing volume with Verkada. As a Gold Partner, Blue Cap IT gets direct access to Verkada engineering for escalations, early access to new products, and competitive pricing that we pass through to our clients. We're not a reseller forwarding tickets — we're a certified team that designs, installs, configures, and supports the full Verkada stack ourselves across Maryland, DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need an NVR or on-site server to use Verkada?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Every Verkada camera has built-in solid-state storage — typically 30 to 365 days of continuous local recording depending on the model. The cameras connect directly to Verkada Command in the cloud, so there's no NVR, DVR, or server to buy, maintain, or replace when it fails. If your internet goes down, the cameras keep recording locally and sync once connectivity returns."
      }
    },
    {
      "@type": "Question",
      "name": "Can I add Verkada products one at a time, or do I have to buy the full platform?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can start with any single product line and add others as you grow. Most clients start with cameras, then layer on access control, alarms, environmental sensors, intercoms, and visitor management over time — all managed from the same Verkada Command dashboard. There's no rip-and-replace when you expand: every Verkada product is designed to work together natively."
      }
    },
    {
      "@type": "Question",
      "name": "How does Verkada pricing work — hardware plus license, subscription, or both?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Both. You purchase the hardware up front (cameras, door controllers, sensors, etc.) and pay an annual or multi-year license per device that includes cloud storage, software updates, AI analytics, and warranty. Blue Cap IT handles the licensing paperwork, tracks renewal dates, and notifies you ahead of expiration so you never have an unexpected lapse. We'll quote your full project — hardware, licenses, installation, and configuration — with itemized pricing after a free site assessment."
      }
    }
  ]
};
---
<MainLayout ogImage="/Cameras_Family_Portrait_Pillars.webp" title="Verkada Products | Blue Cap IT — Mid-Atlantic &amp; Carolinas" description="Verkada cameras, access control, alarms, sensors &amp; intercoms from Blue Cap IT — Verkada Gold Partner serving MD, DC, DE, NJ, PA, VA, NC, SC." schema={faqSchema}>
  <div class="inner-hero">
    <div class="section-inner">
      <div class="crumbs"><a href="index.html">Home</a> <span>/</span> Verkada Products</div>
      <div class="section-label">Official Verkada Gold Partner</div>
      <h1>Verkada <span class="grad">Products</span></h1>
      <p class="section-sub">Blue Cap IT sells, installs, and supports the full Verkada product line. Explore the solutions below and contact us for a free quote on any product.</p>
    </div>
  </div>

  <!-- VERKADA PARTNER LOGO -->
  <section style="padding:1.5rem 4%;">
    <div class="section-inner" style="text-align:center;padding:0 1.5rem;">
      <img src="/images/verkada-partner.webp" alt="Verkada Authorized Reseller" style="max-height:48px;width:auto;" width="1600" height="226" loading="lazy" decoding="async" />
    </div>
  </section>

  <section>
    <div class="section-inner">
      <div class="products-grid">
        <a href="cameras.html" class="product-card" style="text-decoration:none;color:inherit;cursor:pointer;">
          <img src="/Cameras_Family_Portrait_Pillars.webp" alt="Verkada Security Cameras" style="width:100%;border-radius:0.75rem;margin-bottom:1rem;" width="1600" height="900" fetchpriority="high" />
          <h3>Video Security Cameras</h3>
          <p>AI-powered, cloud-managed cameras with built-in storage. No NVR or on-site servers required. View footage from anywhere, on any device.</p>
          <span class="btn-primary" style="margin-top:auto;display:inline-block;">Learn More</span>
        </a>
        <a href="access-control.html" class="product-card" style="text-decoration:none;color:inherit;cursor:pointer;">
          <img src="/241017_Access_Control_Family_hard_shadow.webp" alt="Verkada Access Control" style="width:100%;border-radius:0.75rem;margin-bottom:1rem;" width="1600" height="1066" loading="lazy" decoding="async" />
          <h3>Access Control</h3>
          <p>Cloud-based door access with mobile credentials, badge readers, and real-time management. Secure every entrance from one dashboard.</p>
          <span class="btn-primary" style="margin-top:auto;display:inline-block;">Learn More</span>
        </a>
        <a href="sensors.html" class="product-card" style="text-decoration:none;color:inherit;cursor:pointer;">
          <img src="/air-quality-hero.webp" alt="Verkada Air Quality Sensors" style="width:100%;border-radius:0.75rem;margin-bottom:1rem;" width="1600" height="1067" loading="lazy" decoding="async" />
          <h3>Air Quality Sensors</h3>
          <p>Monitor air quality, temperature, humidity, and motion across your facilities. Get real-time alerts when conditions go out of range.</p>
          <span class="btn-primary" style="margin-top:auto;display:inline-block;">Learn More</span>
        </a>
        <a href="alarms.html" class="product-card" style="text-decoration:none;color:inherit;cursor:pointer;">
          <img src="/250916_Alarms_Family_right_Side_2_0030.webp" alt="Verkada Alarms" style="width:100%;border-radius:0.75rem;margin-bottom:1rem;" width="1600" height="1066" loading="lazy" decoding="async" />
          <h3>Alarms &amp; Intrusion Detection</h3>
          <p>Wireless alarm panels, door and window sensors, and motion detectors — all managed through Verkada Command with professional monitoring.</p>
          <span class="btn-primary" style="margin-top:auto;display:inline-block;">Learn More</span>
        </a>
        <a href="intercom.html" class="product-card" style="text-decoration:none;color:inherit;cursor:pointer;">
          <img src="/240919_Intercom_SH050_Trio_ALT_005_web_Still0176.webp" alt="Verkada Intercoms" style="width:100%;border-radius:0.75rem;margin-bottom:1rem;" width="1600" height="900" loading="lazy" decoding="async" />
          <h3>Intercoms &amp; Visitor Management</h3>
          <p>Video intercoms for building entries with remote unlock, two-way audio, and visitor logs. Manage access from your phone or desktop.</p>
          <span class="btn-primary" style="margin-top:auto;display:inline-block;">Learn More</span>
        </a>
        <a href="command.html" class="product-card" style="text-decoration:none;color:inherit;cursor:pointer;">
          <img src="/240719_Badges_Laptop_Mobile_Straight01.webp" alt="Verkada Command Software" style="width:100%;border-radius:0.75rem;margin-bottom:1rem;" width="1600" height="878" loading="lazy" decoding="async" />
          <h3>Verkada Command</h3>
          <p>The cloud platform that ties everything together. Manage cameras, access control, sensors, alarms, and intercoms from one unified dashboard.</p>
          <span class="btn-primary" style="margin-top:auto;display:inline-block;">Learn More</span>
        </a>
        <a href="command-connector.html" class="product-card" style="text-decoration:none;color:inherit;cursor:pointer;">
          <img src="/command-connector-hero.webp" alt="Verkada Command Connector" style="width:100%;border-radius:0.75rem;margin-bottom:1rem;" width="1600" height="998" loading="lazy" decoding="async" />
          <h3>Command Connector</h3>
          <p>Integrate third-party and legacy cameras into Verkada Command. Keep your existing camera investment while gaining cloud management and AI analytics.</p>
          <span class="btn-primary" style="margin-top:auto;display:inline-block;">Learn More</span>
        </a>
        <a href="workplace.html" class="product-card" style="text-decoration:none;color:inherit;cursor:pointer;">
          <img src="/workplace-hero.webp" alt="Verkada Workplace" style="width:100%;border-radius:0.75rem;margin-bottom:1rem;" width="1600" height="1067" loading="lazy" decoding="async" />
          <h3>Workplace</h3>
          <p>Digital visitor management, mailroom tracking, badge printing, and guest pre-registration — all managed through Verkada Command.</p>
          <span class="btn-primary" style="margin-top:auto;display:inline-block;">Learn More</span>
        </a>
        <a href="connectivity.html" class="product-card" style="text-decoration:none;color:inherit;cursor:pointer;">
          <img src="/connectivity-hero.webp" alt="Verkada Connectivity" style="width:100%;border-radius:0.75rem;margin-bottom:1rem;" width="1600" height="899" loading="lazy" decoding="async" />
          <h3>Connectivity</h3>
          <p>Cellular gateways and managed switches for reliable network connectivity. Ideal for remote sites or as backup when wired internet is unavailable.</p>
          <span class="btn-primary" style="margin-top:auto;display:inline-block;">Learn More</span>
        </a>
      </div>
    </div>
  </section>

  <section>
    <div class="section-inner" style="padding:4rem 1.5rem;">
      <div style="text-align:center;max-width:700px;margin:0 auto 3rem;">
        <div class="section-label">See It in Action</div>
        <h2>Verkada <span class="grad">in Action</span></h2>
        <p class="section-sub" style="text-align:center;margin:0.8rem auto 0;">Watch how Verkada's cloud-managed platform delivers smarter security through AI-powered analytics, unified management, and real-time intelligence.</p>
      </div>
      <div style="display:grid;grid-template-columns:1fr;gap:3rem;max-width:800px;margin:0 auto;">
        <div>
          <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:1rem;box-shadow:0 8px 32px rgba(0,0,0,0.3);">
            <iframe src="https://www.youtube.com/embed/CUZA14FUce4" title="Verkada AI-Powered Analytics" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position:absolute;top:0;left:0;width:100%;height:100%;"></iframe>
          </div>
          <h3 style="text-align:center;margin-top:1rem;font-size:1.1rem;">AI-Powered Analytics</h3>
        </div>
        <div>
          <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:1rem;box-shadow:0 8px 32px rgba(0,0,0,0.3);">
            <iframe src="https://www.youtube.com/embed/OQIfYbs6qno" title="Verkada Point of Sale Fraud Detection" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position:absolute;top:0;left:0;width:100%;height:100%;"></iframe>
          </div>
          <h3 style="text-align:center;margin-top:1rem;font-size:1.1rem;">Point of Sale Fraud Detection</h3>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-inner" style="text-align:center;max-width:700px;margin:0 auto;padding:2rem 1.5rem 4rem;">
      <div class="section-label">Resources</div>
      <h2>Verkada <span class="grad">Downloads</span></h2>
      <p class="section-sub" style="text-align:center;margin:0.8rem auto 2rem;">Download product overviews and case studies to learn more about the Verkada platform.</p>
      <div style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:center;">
        <a href="/verkada/docs/verkada-overview.pdf" target="_blank" class="btn-ghost" style="display:inline-flex;align-items:center;gap:0.5rem;"><Icon name="lucide:file-text" /> Verkada Overview</a>
        <a href="/verkada/docs/verkada-platform.pdf" target="_blank" class="btn-ghost" style="display:inline-flex;align-items:center;gap:0.5rem;"><Icon name="lucide:file-text" /> Verkada Platform Overview</a>
        <a href="/verkada/docs/case-study-offices.pdf" target="_blank" class="btn-ghost" style="display:inline-flex;align-items:center;gap:0.5rem;"><Icon name="lucide:file-text" /> Case Study: Offices</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bcit-faq" aria-labelledby="verkada-faq-heading">
    <h2 id="verkada-faq-heading" class="bcit-faq__heading">Frequently Asked Questions</h2>
    <p class="bcit-faq__intro">Common questions about Verkada cloud-managed security cameras, access control, alarms, sensors, intercoms, and visitor management from Blue Cap IT, an official Verkada Gold Partner serving Maryland, DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina.</p>

    <details class="bcit-faq__item">
      <summary>What is Verkada, and how is it different from traditional security camera systems?</summary>
      <div class="bcit-faq__answer">
        <p>Verkada is a cloud-managed physical security platform — cameras, access control, alarms, sensors, and intercoms — that's managed entirely through one web dashboard called Verkada Command. Unlike traditional NVR-based systems that require on-site servers, complex configuration, and clunky software, every Verkada device stores footage locally and connects directly to the cloud. You view live and recorded video from any browser or phone, anywhere in the world, with no port forwarding, no dynamic DNS, and no IT headaches.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>What does it mean that Blue Cap IT is a Verkada Gold Partner?</summary>
      <div class="bcit-faq__answer">
        <p>Verkada Gold is one of the highest partner tiers — earned through certified training, demonstrated installation expertise, and ongoing volume with Verkada. As a Gold Partner, Blue Cap IT gets direct access to Verkada engineering for escalations, early access to new products, and competitive pricing that we pass through to our clients. We're not a reseller forwarding tickets — we're a certified team that designs, installs, configures, and supports the full Verkada stack ourselves across Maryland, DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Do I need an NVR or on-site server to use Verkada?</summary>
      <div class="bcit-faq__answer">
        <p>No. Every Verkada camera has built-in solid-state storage — typically 30 to 365 days of continuous local recording depending on the model. The cameras connect directly to Verkada Command in the cloud, so there's no NVR, DVR, or server to buy, maintain, or replace when it fails. If your internet goes down, the cameras keep recording locally and sync once connectivity returns.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Can I add Verkada products one at a time, or do I have to buy the full platform?</summary>
      <div class="bcit-faq__answer">
        <p>You can start with any single product line and add others as you grow. Most clients start with cameras, then layer on access control, alarms, environmental sensors, intercoms, and visitor management over time — all managed from the same Verkada Command dashboard. There's no rip-and-replace when you expand: every Verkada product is designed to work together natively.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>How does Verkada pricing work — hardware plus license, subscription, or both?</summary>
      <div class="bcit-faq__answer">
        <p>Both. You purchase the hardware up front (cameras, door controllers, sensors, etc.) and pay an annual or multi-year license per device that includes cloud storage, software updates, AI analytics, and warranty. Blue Cap IT handles the licensing paperwork, tracks renewal dates, and notifies you ahead of expiration so you never have an unexpected lapse. We'll quote your full project — hardware, licenses, installation, and configuration — with itemized pricing after a free site assessment.</p>
      </div>
    </details>

    <div class="bcit-faq__cta">
      <p><strong>Still have questions?</strong> Call <a href="tel:4108584031">(410) 858-4031</a> or <a href="/contact">request a free site assessment</a> — we'll walk your facility, identify coverage needs, and recommend the right Verkada products and licenses for your business.</p>
    </div>
  </section>

  <div class="cta-band">
    <div class="section-label">Let's Talk</div>
    <h2>Ready to Explore<br/><span class="grad">Verkada Solutions?</span></h2>
    <p>Contact Blue Cap IT for a free site assessment and product recommendation. We'll help you choose the right Verkada products for your needs — with transparent pricing and expert installation.</p>
    <div class="btn-group">
      <a href="contact.html" class="btn-primary">Get a Free Quote</a>
      <a href="tel:4108584031" class="btn-ghost"><Icon name="lucide:phone" /> (410) 858-4031</a>
      <a href="mailto:info@bluecapit.com" class="btn-ghost"><Icon name="lucide:mail" /> info@bluecapit.com</a>
    </div>
  </div>
</MainLayout>
