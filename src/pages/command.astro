---
import MainLayout from '../layouts/MainLayout.astro';
import { Icon } from 'astro-icon/components';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Verkada Command, and how do I access it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Verkada Command is the cloud platform that unifies every Verkada device — cameras, access control, alarms, sensors, intercoms, visitor management — in one browser-based dashboard. You access it at command.verkada.com from any modern browser, with no VPN, no port forwarding, and no client software to install. The same dashboard works on a desktop, a tablet, or a phone, and there are dedicated iOS and Android mobile apps for live view, playback, and remote unlock on the go."
      }
    },
    {
      "@type": "Question",
      "name": "Is Verkada Command included with the cameras, or do I pay separately?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Command is included with every Verkada device license. When you buy a camera, door controller, or sensor, you pay an annual or multi-year license per device that covers cloud storage, software updates, AI analytics, the Command dashboard, mobile app access, and warranty. There's no separate per-user fee, no extra charge for the platform, and no Command tier upsell. Adding more users to your organization doesn't add cost — the license is per device, not per seat."
      }
    },
    {
      "@type": "Question",
      "name": "How does user management work — can I limit what each person sees?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, in detail. Command supports custom roles with granular permissions, so you can give the office manager full access to one site while limiting a department head to only their floor's cameras. Permissions can be set per camera, per door, per location, and per function (live view only, archive access, user management, etc.). Every admin action is logged in an audit trail — who logged in, what they viewed, what they changed, when. The mobile app respects the same permissions as the web dashboard."
      }
    },
    {
      "@type": "Question",
      "name": "Does Verkada Command integrate with our identity provider — Okta, Azure AD, or Google Workspace?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Command supports SAML 2.0 SSO with all major identity providers including Okta, Microsoft Entra ID (formerly Azure AD), and Google Workspace. This means employees sign in with their work credentials and lose access automatically when they leave the company — no separate Command password to revoke. Multi-factor authentication is enforced through your IdP, and provisioning rules can be managed centrally. Blue Cap IT handles the SSO integration during onboarding."
      }
    },
    {
      "@type": "Question",
      "name": "How does Verkada handle data security and uptime?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Command is hosted on a hardened cloud infrastructure with end-to-end encryption for data in transit and at rest, regular third-party penetration testing, and a 99.9% uptime SLA from Verkada. Footage is encrypted on the camera, encrypted in transit, and encrypted in cloud storage. Verkada is SOC 2 Type II certified and meets compliance standards required by healthcare, education, finance, and government clients. If something does go wrong, your cameras keep recording locally and your access control keeps functioning — Command going offline doesn't take down the physical security itself."
      }
    }
  ]
};
---
<MainLayout title="Verkada Command Platform | Blue Cap IT — Gold Partner" description="Verkada Command is the unified cloud platform for managing cameras, access control, sensors, alarms, and intercoms from one dashboard. No servers, no VPNs — deployed by Blue Cap IT." schema={faqSchema}>
  <div class="inner-hero">
    <div class="section-inner">
      <div class="crumbs"><a href="index.html">Home</a> <span>/</span> <a href="verkada.html">Verkada Solutions</a> <span>/</span> Verkada Command</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:center;">
        <div>
          <div class="section-label">Verkada Platform</div>
          <h1>Verkada <span class="grad">Command</span></h1>
          <p class="section-sub">The unified cloud platform that ties every Verkada device together. One login. One dashboard. Complete physical security visibility.</p>
          <div style="margin-top:2rem;display:flex;gap:1rem;flex-wrap:wrap;">
            <a href="contact.html" class="btn-primary">Get a Free Quote</a>
            <a href="tel:4108584031" class="btn-ghost btn-sm"><Icon name="lucide:phone" /> (410) 858-4031</a>
          </div>
        </div>
        <img src="/240719_Badges_Laptop_Mobile_Straight01.png" alt="Verkada Command Platform" class="feature-img"/>
      </div>
    </div>
  </div>

  <section>
    <div class="section-inner">
      <div class="feature-list">
        <div class="feature-row">
          <div class="feature-visual">
            <div class="feature-visual-bg"></div>
            <img src="/240719_Badges_Laptop_Mobile_Straight01.png" alt="Verkada Command Dashboard" style="max-width:400px;width:100%;filter:drop-shadow(0 16px 48px rgba(0,0,0,0.5));border-radius:8px;"/>
          </div>
          <div class="feature-content">
            <h3>One Dashboard for Everything</h3>
            <p>Verkada Command unifies cameras, access control, sensors, alarms, and intercoms in a single browser-based interface. No switching between apps or systems.</p>
            <ul class="feature-bullets">
              <li>Live camera feeds and archived footage</li>
              <li>Real-time access control events and door status</li>
              <li>Sensor readings and environmental alerts</li>
              <li>Alarm status and incident history</li>
              <li>Visitor logs and intercom activity</li>
            </ul>
          </div>
        </div>
        <div class="feature-row rev">
          <div class="feature-visual"><div class="feature-visual-bg"></div><div class="big-icon"><Icon name="lucide:shield" /></div></div>
          <div class="feature-content">
            <h3>Zero IT Infrastructure Required</h3>
            <p>Verkada Command is 100% cloud-hosted. No on-site servers, no VPNs, no complex network configuration. Devices plug in and appear in your dashboard automatically.</p>
            <ul class="feature-bullets">
              <li>No NVR, DVR, or on-premise servers</li>
              <li>No VPN required for remote access</li>
              <li>Automatic firmware updates by Verkada</li>
              <li>99.9% uptime SLA from Verkada</li>
              <li>End-to-end encrypted data transmission</li>
            </ul>
          </div>
        </div>
        <div class="feature-row">
          <div class="feature-visual"><div class="feature-visual-bg"></div><div class="big-icon"><Icon name="lucide:users" /></div></div>
          <div class="feature-content">
            <h3>Enterprise-Grade User Management</h3>
            <p>Granular role-based access control means every user sees only what they need to. Integrate with your existing identity provider via SAML SSO.</p>
            <ul class="feature-bullets">
              <li>Custom roles and permission levels</li>
              <li>SAML 2.0 SSO (Okta, Azure AD, Google)</li>
              <li>Multi-organization and multi-site support</li>
              <li>Full admin audit trail</li>
              <li>Mobile app for iOS &amp; Android</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="section-inner" style="text-align:center;max-width:800px;margin:0 auto;padding:4rem 1.5rem;">
      <div class="section-label">See It in Action</div>
      <h2>Searching in <span class="grad">Verkada Command</span></h2>
      <p class="section-sub" style="text-align:center;margin:0.8rem auto 2rem;">See how easy it is to search across all your cameras, doors, and devices from one unified dashboard.</p>
      <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;border-radius:1rem;box-shadow:0 8px 32px rgba(0,0,0,0.3);">
        <iframe src="https://www.youtube.com/embed/H4f0hVifcWs" title="Searching in Verkada Command" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen style="position:absolute;top:0;left:0;width:100%;height:100%;"></iframe>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bcit-faq" aria-labelledby="command-faq-heading">
    <h2 id="command-faq-heading" class="bcit-faq__heading">Frequently Asked Questions</h2>
    <p class="bcit-faq__intro">Common questions about Verkada Command — the cloud platform that unifies cameras, access control, alarms, sensors, intercoms, and visitor management — from Blue Cap IT, an official Verkada Gold Partner serving businesses across Maryland, DC, Delaware, New Jersey, Pennsylvania, Virginia, North Carolina, and South Carolina.</p>

    <details class="bcit-faq__item">
      <summary>What is Verkada Command, and how do I access it?</summary>
      <div class="bcit-faq__answer">
        <p>Verkada Command is the cloud platform that unifies every Verkada device — cameras, access control, alarms, sensors, intercoms, visitor management — in one browser-based dashboard. You access it at command.verkada.com from any modern browser, with no VPN, no port forwarding, and no client software to install. The same dashboard works on a desktop, a tablet, or a phone, and there are dedicated iOS and Android mobile apps for live view, playback, and remote unlock on the go.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Is Verkada Command included with the cameras, or do I pay separately?</summary>
      <div class="bcit-faq__answer">
        <p>Command is included with every Verkada device license. When you buy a camera, door controller, or sensor, you pay an annual or multi-year license per device that covers cloud storage, software updates, AI analytics, the Command dashboard, mobile app access, and warranty. There's no separate per-user fee, no extra charge for the platform, and no Command tier upsell. Adding more users to your organization doesn't add cost — the license is per device, not per seat.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>How does user management work — can I limit what each person sees?</summary>
      <div class="bcit-faq__answer">
        <p>Yes, in detail. Command supports custom roles with granular permissions, so you can give the office manager full access to one site while limiting a department head to only their floor's cameras. Permissions can be set per camera, per door, per location, and per function (live view only, archive access, user management, etc.). Every admin action is logged in an audit trail — who logged in, what they viewed, what they changed, when. The mobile app respects the same permissions as the web dashboard.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>Does Verkada Command integrate with our identity provider — Okta, Azure AD, or Google Workspace?</summary>
      <div class="bcit-faq__answer">
        <p>Yes. Command supports SAML 2.0 SSO with all major identity providers including Okta, Microsoft Entra ID (formerly Azure AD), and Google Workspace. This means employees sign in with their work credentials and lose access automatically when they leave the company — no separate Command password to revoke. Multi-factor authentication is enforced through your IdP, and provisioning rules can be managed centrally. Blue Cap IT handles the SSO integration during onboarding.</p>
      </div>
    </details>

    <details class="bcit-faq__item">
      <summary>How does Verkada handle data security and uptime?</summary>
      <div class="bcit-faq__answer">
        <p>Command is hosted on a hardened cloud infrastructure with end-to-end encryption for data in transit and at rest, regular third-party penetration testing, and a 99.9% uptime SLA from Verkada. Footage is encrypted on the camera, encrypted in transit, and encrypted in cloud storage. Verkada is SOC 2 Type II certified and meets compliance standards required by healthcare, education, finance, and government clients. If something does go wrong, your cameras keep recording locally and your access control keeps functioning — Command going offline doesn't take down the physical security itself.</p>
      </div>
    </details>

    <div class="bcit-faq__cta">
      <p><strong>Still have questions?</strong> Call <a href="tel:4108584031">(410) 858-4031</a> or <a href="/contact">request a free Verkada Command demo</a> — we'll walk you through a live dashboard, show how user permissions and SSO work with your environment, and quote your full project with itemized pricing.</p>
    </div>
  </section>

  <div class="cta-band">
    <div class="section-label">Get Started</div>
    <h2>Experience Verkada Command<br/><span class="grad">with Blue Cap IT</span></h2>
    <p>We'll walk you through a live Verkada Command demo and show you exactly how it would look with your organization's devices and layout.</p>
    <div class="btn-group">
      <a href="contact.html" class="btn-primary">Get a Free Quote</a>
      <a href="tel:4108584031" class="btn-ghost"><Icon name="lucide:phone" /> (410) 858-4031</a>
      <a href="mailto:info@bluecapit.com" class="btn-ghost"><Icon name="lucide:mail" /> info@bluecapit.com</a>
    </div>
  </div>
</MainLayout>
